        <input type="hidden" name="bot-field" />
        <input type="hidden" name="summer-load-now" id="f-load-now" />
        <input type="hidden" name="summer-load-evening" id="f-load-evening" />
        <input type="hidden" name="summer-events" id="f-events" />
        <input
          type="email"
          name="email"
          placeholder={copy.form.emailPlaceholder}
