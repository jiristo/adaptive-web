---
import { type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = lang === 'cs'
  ? {
      heroTag: 'NÁSTROJ · LÉTO',
      heroTitle: 'Jak moc vás\nléto přetěžuje?',
      heroLead: 'A jestli tělo ještě zvládá regenerovat.',
      heroBody: 'Horko, horší spánek, alkohol, dehydratace a pohyb ve špatný čas. Tento nástroj ukáže, kdy se letní zátěž mění v přetížení nervového systému.',
      heroPrimary: 'Zjistit dnešní zátěž',
      heroSecondary: 'Proč na tom záleží',
      introTag: 'CO SE V LÉTĚ DĚJE',
      introTitle: 'Tělo nemusí být přetížené jen stresem.',
      introCards: [
        { stat: '32 °C', tag: 'TEPLO', title: 'Horko samo o sobě něco stojí', body: 'Když tělo celý den chladí samo sebe, roste spotřeba energie, zhoršuje se soustředění a večer bývá těžší opravdu vypnout.' },
        { stat: '1 noc', tag: 'SPÁNEK', title: 'Špatná noc se v létě rychle násobí', body: 'Přehřátý pokoj, pozdní světlo a alkohol zvyšují pravděpodobnost, že se ráno probudíte unavení a méně odolní vůči další zátěži.' },
        { stat: '18:00', tag: 'TIMING', title: 'Rozhoduje i to, kdy zatěžujete', body: 'Stejný trénink nebo dlouhý pobyt na slunci má jiný dopad dopoledne než večer. Letní únava je často problém načasování.' },
      ],
      toolTag: 'INTERAKTIVNÍ NÁSTROJ',
      toolTitle: 'Sestavte svůj letní den.',
      toolBody: 'Nastavte základní stav a přidejte to, co se dnes stalo. Křivka ukáže, jestli tělo ještě zvládá držet výkon, nebo už potřebuje stáhnout zátěž a vrátit se do klidu.',
      baselineTitle: 'Výchozí stav',
      controls: {
        sleep: 'Spánek minulá noc',
        hydration: 'Hydratace během dne',
        heat: 'Teplota / pocit horka',
        alcohol: 'Alkohol včera večer',
        training: 'Pohyb a zátěž dnes',
      },
      options: {
        sleep: ['Dobrá — 7–9 h', 'Průměrná — 6–7 h', 'Slabá — pod 6 h', 'Přerušovaná a neklidná'],
        hydration: ['Dobrá — průběžně piju', 'Spíš průměrná', 'Nízká — piju málo', 'Velmi nízká — sucho, bolest hlavy'],
        heat: ['Mírné léto / stín', 'Teplý den', 'Horký den', 'Extrémní horko / dusno'],
        alcohol: ['Žádný', '1–2 drinky', 'Více drinků', 'Těžký večer'],
        training: ['Klidný den', 'Lehký pohyb', 'Trénink / dlouhá chůze', 'Náročný výkon v horku'],
      },
      eventsTitle: 'Události dne',
      eventHelp: 'Vyberte událost, zadejte hodinu, stiskněte +',
      noEvents: 'Zatím žádné události. Přidejte co se dnes stalo.',
      eventGroups: {
        stress: '☀ Letní zátěž',
        relief: '❄ Ochlazení',
        other: '○ Ostatní',
      },
      metrics: {
        now: 'Aktuální zatížení',
        peak: 'Denní maximum',
        evening: 'Večer 20:00',
        phase: 'Fáze dne',
      },
      gaugeTitle: 'Míra letního přetížení — aktuální hodina',
      zones: { low: 'Lehké', optimal: 'V normě', high: 'Přetížené', critical: 'Na hraně' },
      chartAria: 'Denní křivka letního přetížení',
      time: 'čas:',
      eveningTitle: 'Regenerace večer (20:00)',
      eveningIdeal: 'Ideál pro zklidnění systému: 20–35 bodů',
      eveningValueLabel: 'Vaše odhadovaná zátěž',
      eveningIdealLabel: 'Večerní cíl',
      disclaimer: '⚠ Edukativní model, nikoliv lékařský test. Ukazuje pravděpodobnou míru přetížení nervového systému v létě, ne klinickou diagnózu.',
      servicesTag: 'JAK S TÍM PRACOVAT',
      servicesTitle: 'V létě často neřešíte jen únavu.',
      servicesBody: 'Často řešíte přehřátý systém, který už neumí přepnout. Ve studiu pracujeme s dechem, chladem, světlem, pohybem a timingem zátěže tak, aby se tělo vrátilo do klidu i výkonu.',
      serviceCards: [
        { tag: 'Ochladit', title: 'Kryo a chlad', body: 'Když se tělo přehřívá a večer se neumí stáhnout, chlad vrací ostřejší hranici mezi aktivací a regenerací.' },
        { tag: 'Zklidnit', title: 'Dech a nervový systém', body: 'Nejde jen o fyzické ochlazení. Potřebujete i signál bezpečí, aby tělo přestalo držet napětí a mohlo vypnout.' },
        { tag: 'Načasovat', title: 'Pohyb a regenerace', body: 'Stejná aktivita může v létě pomoci nebo uškodit. Rozhoduje čas, intenzita i to, co předcházelo.' },
      ],
      ctaTag: 'PRVNÍ KROK',
      ctaTitle: 'Chcete vědět, co vaše tělo v létě opravdu vyčerpává?',
      ctaBody: 'Prvním krokem je krátký rozhovor. Podíváme se, jestli řešíte horko, spánek, přetížený nervový systém, nebo špatně načasovanou zátěž.',
      ctaNote: 'Bez závazku.',
      ctaButton: 'Zarezervovat konzultaci',
      currentMessages: {
        low: 'Zatížení je nízké. Tělo má prostor držet výkon i regeneraci.',
        optimal: 'Zatížení je v rozumném pásmu. Hlídal bych hlavně hydrataci, světlo a večerní zklidnění.',
        high: 'Tělo je přetížené. Pokud teď nepřijde ochlazení a zklidnění, večer i spánek budou slabší.',
        critical: 'Systém je na hraně. Tady už nejde jen o únavu, ale o zhoršenou schopnost obnovy a vyšší šanci večerního pádu.',
      },
      phaseTips: [
        'Noční minimum. Pokud je zátěž i teď vysoko, tělo se přes noc neobnovuje naplno.',
        'Ráno by systém měl nabírat energii bez přehřátí. Sledujte, jestli vstáváte svěží, nebo už unavení.',
        'Dopolední výkonnostní okno. Pokud je skóre vysoko už teď, horko a spánek se kumulují rychleji než čekáte.',
        'Nejvyšší teplotní tlak dne. Tady se často láme rozdíl mezi normální únavou a skutečným přetížením.',
        'Večer by zátěž měla klesat. Pokud neklesá, bývá problém v hydrataci, alkoholu, pozdním pohybu nebo přehřátém prostředí.',
      ],
      interventions: {
        highTitle: 'Přetížení je vysoké — stáhnout zátěž',
        highSub: 'Teď dává smysl ochlazení, hydratace a snížení aktivity.',
        criticalTitle: 'Systém je na hraně — priorita je obnova',
        criticalSub: 'Dál už nepřidávat výkon. Tělo potřebuje bezpečí, chlad a návrat do klidu.',
      },
      interventionTags: {
        cool: 'Chlad / stín',
        water: 'Hydratace + minerály',
        breath: 'Dechová práce',
        rest: 'Lehnout / nohy nahoru',
        redlight: 'Večerní zklidnění',
        consult: 'Konzultace — Adaptive Studio',
      },
      form: {
        emailPlaceholder: 'váš@email.cz',
        success: '✓ Výborně — ozveme se vám do 24 hodin.',
        note: 'Bez spamu. Pouze jeden kontakt od nás.',
      },
    }
  : {
      heroTag: 'TOOL · SUMMER',
      heroTitle: 'How much is\nsummer overloading you?',
      heroLead: 'And whether your body can still recover well.',
      heroBody: 'Heat, poor sleep, alcohol, dehydration, and training at the wrong time. This tool shows when summer strain starts becoming nervous-system overload.',
      heroPrimary: 'Check today’s load',
      heroSecondary: 'Why it matters',
      introTag: 'WHAT HAPPENS IN SUMMER',
      introTitle: 'The body is not overloaded by stress alone.',
      introCards: [
        { stat: '32 °C', tag: 'HEAT', title: 'Heat itself has a cost', body: 'When the body spends the whole day cooling itself, energy drops, focus worsens, and it becomes harder to truly switch off in the evening.' },
        { stat: '1 night', tag: 'SLEEP', title: 'One poor summer night compounds fast', body: 'An overheated room, late light exposure, and alcohol increase the odds that you wake up tired and less resilient to the rest of the day.' },
        { stat: '18:00', tag: 'TIMING', title: 'Timing matters too', body: 'The same training session or long sun exposure hits differently in the morning than in the evening. Summer fatigue is often a timing problem.' },
      ],
      toolTag: 'INTERACTIVE TOOL',
      toolTitle: 'Build your summer day.',
      toolBody: 'Set your baseline and add what happened today. The curve shows whether the body can still hold performance or whether it needs to cool down and return to calm.',
      baselineTitle: 'Baseline state',
      controls: {
        sleep: 'Sleep last night',
        hydration: 'Hydration during the day',
        heat: 'Temperature / heat intensity',
        alcohol: 'Alcohol last night',
        training: 'Movement and load today',
      },
      options: {
        sleep: ['Good, 7–9 h', 'Average, 6–7 h', 'Weak, under 6 h', 'Broken and restless'],
        hydration: ['Good, drinking steadily', 'Somewhat average', 'Low, not drinking enough', 'Very low, dry mouth or headache'],
        heat: ['Mild summer / shade', 'Warm day', 'Hot day', 'Extreme heat / humidity'],
        alcohol: ['None', '1–2 drinks', 'Several drinks', 'Heavy night'],
        training: ['Calm day', 'Light movement', 'Training / long walk', 'Hard effort in the heat'],
      },
      eventsTitle: 'Events during the day',
      eventHelp: 'Choose an event, enter the hour, then press +',
      noEvents: 'No events yet. Add what happened today.',
      eventGroups: {
        stress: '☀ Summer strain',
        relief: '❄ Cooling',
        other: '○ Other',
      },
      metrics: {
        now: 'Current load',
        peak: 'Daily peak',
        evening: 'Evening 20:00',
        phase: 'Phase of the day',
      },
      gaugeTitle: 'Summer overload level — current hour',
      zones: { low: 'Light', optimal: 'In range', high: 'Overloaded', critical: 'At the edge' },
      chartAria: 'Daily summer overload curve',
      time: 'time:',
      eveningTitle: 'Evening recovery (20:00)',
      eveningIdeal: 'Ideal for downshifting: 20–35 points',
      eveningValueLabel: 'Your estimated load',
      eveningIdealLabel: 'Evening target',
      disclaimer: '⚠ Educational model, not a medical test. It estimates likely summer strain on the nervous system, not a clinical diagnosis.',
      servicesTag: 'HOW TO WORK WITH IT',
      servicesTitle: 'In summer, people are rarely dealing with fatigue alone.',
      servicesBody: 'They are often dealing with an overheated system that no longer knows how to switch off. In the studio we work with breath, cold, light, movement, and timing so the body can return to calm and performance.',
      serviceCards: [
        { tag: 'Cool down', title: 'Cryo and cold', body: 'When the body overheats and cannot settle in the evening, cold helps restore a clearer boundary between activation and recovery.' },
        { tag: 'Downshift', title: 'Breath and nervous system', body: 'Physical cooling is not enough on its own. The body also needs a signal of safety so it can stop holding tension.' },
        { tag: 'Time it better', title: 'Movement and recovery', body: 'The same activity can help or hurt in summer. Timing, intensity, and what came before all matter.' },
      ],
      ctaTag: 'FIRST STEP',
      ctaTitle: 'Want to know what is actually draining your body in summer?',
      ctaBody: 'The first step is a short conversation. We look at whether the issue is heat, sleep, nervous-system overload, or badly timed physical load.',
      ctaNote: 'No commitment.',
      ctaButton: 'Book a consultation',
      currentMessages: {
        low: 'Load is low. The body has room for both performance and recovery.',
        optimal: 'Load is within a reasonable range. I would mainly watch hydration, light exposure, and how you downshift in the evening.',
        high: 'The body is overloaded. Without cooling and downregulation now, both the evening and sleep will probably be weaker.',
        critical: 'The system is at the edge. This is no longer just fatigue. Recovery capacity is already compromised.',
      },
      phaseTips: [
        'Night minimum. If load is still high here, the body is not fully restoring overnight.',
        'Morning should build energy without overheating. Watch whether you wake up fresh or already tired.',
        'Late morning performance window. If the score is already high now, heat and poor sleep are accumulating faster than expected.',
        'The highest thermal pressure of the day. This is often where the line between normal fatigue and actual overload gets crossed.',
        'Load should drop in the evening. If it does not, hydration, alcohol, late training, or an overheated environment are often part of the problem.',
      ],
      interventions: {
        highTitle: 'Load is high — reduce the strain',
        highSub: 'Cooling, hydration, and lowering activity make sense now.',
        criticalTitle: 'System at the edge — recovery comes first',
        criticalSub: 'Do not keep pushing. The body needs safety, cold, and a return to calm.',
      },
      interventionTags: {
        cool: 'Cold / shade',
        water: 'Hydration + minerals',
        breath: 'Breathwork',
        rest: 'Lie down / elevate legs',
        redlight: 'Evening downshift',
        consult: 'Consultation — Adaptive Studio',
      },
      form: {
        emailPlaceholder: 'your@email.com',
        success: '✓ Great — we will get back to you within 24 hours.',
        note: 'No spam. One contact from us only.',
      },
    };
---

<main>
  <section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">
    <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-10">{copy.heroTag}</p>
    <h1 class="font-heading font-bold leading-[0.9] tracking-tight text-zinc-900 mb-10 reveal"
        style="font-size: clamp(3rem, 9vw, 8rem)">
      {copy.heroTitle}
    </h1>
    <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-xl reveal reveal-delay-1">
      {copy.heroLead}
    </p>
    <p class="text-sm text-zinc-400 leading-relaxed max-w-lg mt-4 reveal reveal-delay-2">
      {copy.heroBody}
    </p>
    <div class="mt-12 flex flex-wrap gap-4 reveal reveal-delay-3">
      <a href="#tool" class="inline-flex items-center justify-center px-10 py-4 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200">
        {copy.heroPrimary}
      </a>
      <a href="#what" class="inline-flex items-center justify-center px-10 py-4 border border-zinc-300 text-zinc-700 text-xs font-semibold tracking-[0.2em] uppercase hover:border-zinc-900 transition-colors duration-200">
        {copy.heroSecondary}
      </a>
    </div>
  </section>

  <section id="what" class="border-t border-zinc-100 px-6 sm:px-10 lg:px-20 py-24">
    <div class="mb-16 reveal">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">{copy.introTag}</p>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
        {copy.introTitle}
      </h2>
    </div>
    <div class="grid md:grid-cols-3 md:divide-x divide-zinc-200 gap-16 md:gap-0">
      {copy.introCards.map((card, index) => (
        <div class={`flex flex-col ${index === 0 ? 'md:pr-12' : index === 1 ? 'md:px-12' : 'md:pl-12'} reveal ${index === 0 ? 'reveal-delay-1' : index === 1 ? 'reveal-delay-2' : 'reveal-delay-3'}`}>
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">{card.stat}</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">{card.tag}</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">{card.title}</p>
          <p class="text-zinc-500 text-sm leading-relaxed">{card.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="tool" class="bg-[#111110] px-6 sm:px-10 lg:px-20 py-24">
    <div class="mb-12 reveal">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">{copy.toolTag}</p>
      <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight text-white">
        {copy.toolTitle}
      </h2>
      <p class="text-zinc-400 text-sm mt-4 max-w-lg">
        {copy.toolBody}
      </p>
    </div>

    <div class="grid lg:grid-cols-[300px_1fr] gap-6 items-start">
      <div class="flex flex-col gap-4">
        <div class="border border-zinc-700 bg-zinc-900 p-5">
          <p class="text-[9px] tracking-[0.2em] uppercase text-zinc-300 font-semibold mb-4 pb-3 border-b border-zinc-700">{copy.baselineTitle}</p>
          <div class="space-y-4">
            <div>
              <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">{copy.controls.sleep}</label>
              <select class="s-select" id="sleep">
                <option value="0">{copy.options.sleep[0]}</option>
                <option value="1" selected>{copy.options.sleep[1]}</option>
                <option value="2">{copy.options.sleep[2]}</option>
                <option value="3">{copy.options.sleep[3]}</option>
              </select>
            </div>
            <div>
              <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">{copy.controls.hydration}</label>
              <select class="s-select" id="hydration">
                <option value="0">{copy.options.hydration[0]}</option>
                <option value="1" selected>{copy.options.hydration[1]}</option>
                <option value="2">{copy.options.hydration[2]}</option>
                <option value="3">{copy.options.hydration[3]}</option>
              </select>
            </div>
            <div>
              <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">{copy.controls.heat}</label>
              <select class="s-select" id="heat">
                <option value="0">{copy.options.heat[0]}</option>
                <option value="1" selected>{copy.options.heat[1]}</option>
                <option value="2">{copy.options.heat[2]}</option>
                <option value="3">{copy.options.heat[3]}</option>
              </select>
            </div>
            <div>
              <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">{copy.controls.alcohol}</label>
              <select class="s-select" id="alcohol">
                <option value="0" selected>{copy.options.alcohol[0]}</option>
                <option value="1">{copy.options.alcohol[1]}</option>
                <option value="2">{copy.options.alcohol[2]}</option>
                <option value="3">{copy.options.alcohol[3]}</option>
              </select>
            </div>
            <div>
              <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">{copy.controls.training}</label>
              <select class="s-select" id="training">
                <option value="0">{copy.options.training[0]}</option>
                <option value="1" selected>{copy.options.training[1]}</option>
                <option value="2">{copy.options.training[2]}</option>
                <option value="3">{copy.options.training[3]}</option>
              </select>
            </div>
          </div>
        </div>

        <div class="border border-zinc-700 bg-zinc-900 p-5">
          <p class="text-[9px] tracking-[0.2em] uppercase text-zinc-300 font-semibold mb-4 pb-3 border-b border-zinc-700">{copy.eventsTitle}</p>
          <div class="grid grid-cols-[1fr_64px_36px] gap-1.5 mb-3">
            <select class="s-select text-[11px]" id="event-type-select"></select>
            <input type="number" class="s-select s-hour-input text-center text-[11px]" id="event-hour-input" min="0" max="23" value="13" title="Hour (0–23)">
            <button onclick="addSummerEventFromUI()"
              class="bg-white text-zinc-900 text-lg font-bold hover:bg-sage hover:text-white transition-colors duration-150 flex items-center justify-center">+</button>
          </div>
          <p class="text-[10px] text-zinc-400 mb-3">{copy.eventHelp}</p>
          <div id="summer-events-list">
            <p class="text-[11px] text-zinc-600 leading-relaxed py-2">{copy.noEvents}</p>
          </div>
        </div>
      </div>

      <div class="border border-zinc-800 p-6">
        <div class="grid grid-cols-4 gap-px bg-zinc-800 border border-zinc-800 mb-5">
          <div class="bg-[#111110] px-3 py-3">
            <div class="font-heading text-lg font-bold text-white mb-1" id="m-now">—</div>
            <div class="text-[10px] text-zinc-500">{copy.metrics.now}</div>
          </div>
          <div class="bg-[#111110] px-3 py-3">
            <div class="font-heading text-lg font-bold text-white mb-1" id="m-peak">—</div>
            <div class="text-[10px] text-zinc-500">{copy.metrics.peak}</div>
          </div>
          <div class="bg-[#111110] px-3 py-3">
            <div class="font-heading text-lg font-bold text-white mb-1" id="m-evening">—</div>
            <div class="text-[10px] text-zinc-500">{copy.metrics.evening}</div>
          </div>
          <div class="bg-[#111110] px-3 py-3">
            <div class="font-heading text-[11px] font-bold text-white mb-1 leading-tight" id="m-phase">—</div>
            <div class="text-[10px] text-zinc-500">{copy.metrics.phase}</div>
          </div>
        </div>

        <div class="mb-5">
          <p class="text-[9px] tracking-[0.15em] uppercase text-zinc-500 mb-3">{copy.gaugeTitle}</p>
          <div class="relative h-2.5 rounded-full overflow-visible mb-2"
               style="background: linear-gradient(to right, #2a7d4f 0%, #2a7d4f 25%, #185FA5 25%, #185FA5 50%, #B8962E 50%, #B8962E 75%, #C4603A 75%, #C4603A 100%);">
            <div id="gauge-marker" class="absolute top-[-4px] w-[18px] h-[18px] rounded-full bg-white border-[2.5px] border-zinc-900 -translate-x-1/2 shadow-md z-10 transition-all duration-500" style="left:35%;"></div>
          </div>
          <div class="flex justify-between text-[9px] uppercase tracking-wide mt-2">
            <span style="color:#2a7d4f;" class="font-semibold">{copy.zones.low}</span>
            <span style="color:#185FA5;">{copy.zones.optimal}</span>
            <span style="color:#B8962E;" class="font-semibold">{copy.zones.high}</span>
            <span style="color:#C4603A;" class="font-semibold">{copy.zones.critical}</span>
          </div>
        </div>

        <div class="relative h-[200px] mb-3">
          <canvas id="summerChart" role="img" aria-label={copy.chartAria}></canvas>
        </div>

        <div class="flex items-center gap-3 pt-3 border-t border-zinc-800">
          <span class="text-[11px] text-zinc-500 whitespace-nowrap">{copy.time}</span>
          <input type="range" min="0" max="23" value="13" id="hour-slider" step="1" class="s-slider flex-1">
          <span class="text-sm font-semibold text-white min-w-[40px]" id="hour-out">13:00</span>
        </div>

        <div id="phase-tip" class="mt-3 p-3 bg-zinc-900 border-l-2 border-sage text-[12px] text-zinc-400 leading-relaxed"></div>

        <div class="mt-4 border border-zinc-800">
          <div class="flex items-center gap-3 px-4 py-3 bg-zinc-900 border-b border-zinc-800">
            <span class="text-base">🌙</span>
            <div>
              <div class="text-[11px] font-semibold text-white">{copy.eveningTitle}</div>
