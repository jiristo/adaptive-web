  .s-event-row { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border: 1px solid #52525b; background: #27272a; margin-bottom: 4px; }
  .s-event-bar { width: 3px; height: 20px; border-radius: 1px; flex-shrink: 0; }
  .s-event-label { flex: 1; font-size: 11px; color: #f4f4f5; -webkit-text-fill-color: #f4f4f5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .s-event-del { width: 20px; height: 20px; border: none; background: none; color: #71717a; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: color 0.1s; }
  .s-event-del:hover { color: #ef4444; }
  .s-event-hour { width: 36px; padding: 3px 4px; border: 1px solid #52525b; background: #27272a; color: #f4f4f5; font-size: 11px; text-align: center; -moz-appearance: textfield; caret-color: #f4f4f5; -webkit-text-fill-color: #f4f4f5; color-scheme: dark; }
  .s-event-hour:focus, .s-event-hour:hover, .s-select:hover, .s-select:focus { color: #f4f4f5; -webkit-text-fill-color: #f4f4f5; }
  .s-event-hour::-webkit-inner-spin-button { -webkit-appearance: none; }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<script is:inline define:vars={{ copy, langCode: lang }}>
const BASE_CURVE = [18,16,14,12,12,16,24,32,40,48,56,64,70,74,76,72,66,58,48,38,30,24,20,18];
const PHASES = langCode === 'cs'
  ? ["Noční obnova","Noční obnova","Noční obnova","Noční obnova","Brzké ráno","Ráno","Nástup dne","Dopoledne","Dopoledne","Teplý blok","Polední tlak","Polední tlak","Vrchol dne","Vrchol dne","Vrchol dne","Odpoledne","Odpoledne","Pozdní odpoledne","Večer","Večer","Zklidnění","Zklidnění","Noční pokles","Noční pokles"]
  : ["Night recovery","Night recovery","Night recovery","Night recovery","Early morning","Morning","Start of the day","Late morning","Late morning","Warm block","Midday pressure","Midday pressure","Peak day heat","Peak day heat","Peak day heat","Afternoon","Afternoon","Late afternoon","Evening","Evening","Downshift","Downshift","Night decline","Night decline"];
const labels24 = Array.from({length:24},(_,i)=>`${String(i).padStart(2,'0')}:00`);
const EVENT_TYPES = langCode === 'cs' ? [
  { group:'stress', value:'sun', label:'Polední slunce', icon:'☀', delta:+14, rise:0.2, decay:2.8, type:'stress' },
  { group:'stress', value:'commute', label:'Rozpálené auto / MHD', icon:'🚗', delta:+9, rise:0.3, decay:1.8, type:'stress' },
  { group:'stress', value:'workoutheat', label:'Trénink v horku', icon:'🏋', delta:+18, rise:0.5, decay:3.0, type:'stress' },
  { group:'stress', value:'dehydration', label:'Málo vody', icon:'💧', delta:+12, rise:0.6, decay:4.0, type:'stress' },
  { group:'stress', value:'badmeal', label:'Těžké jídlo / únava', icon:'🍔', delta:+7, rise:0.8, decay:2.5, type:'stress' },
  { group:'relief', value:'shade', label:'Stín / chladná místnost', icon:'🌿', delta:-8, rise:0.3, decay:2.4, type:'relief' },
  { group:'relief', value:'coldshower', label:'Studená sprcha', icon:'🚿', delta:-7, rise:0.2, decay:1.2, type:'relief' },
  { group:'relief', value:'minerals', label:'Voda + minerály', icon:'🧂', delta:-6, rise:0.4, decay:2.5, type:'relief' },
  { group:'relief', value:'breath', label:'Dechová práce', icon:'💬', delta:-5, rise:0.3, decay:1.8, type:'relief' },
  { group:'relief', value:'nap', label:'Krátký odpočinek', icon:'😴', delta:-9, rise:0.3, decay:2.0, type:'relief' },
  { group:'other', value:'alcoholpm', label:'Alkohol večer', icon:'🍷', delta:+10, rise:1.5, decay:4.5, type:'neutral' },
  { group:'other', value:'screens', label:'Obrazovky večer', icon:'📱', delta:+5, rise:0.4, decay:3.5, type:'neutral' },
] : [
  { group:'stress', value:'sun', label:'Midday sun', icon:'☀', delta:+14, rise:0.2, decay:2.8, type:'stress' },
  { group:'stress', value:'commute', label:'Hot car / transport', icon:'🚗', delta:+9, rise:0.3, decay:1.8, type:'stress' },
  { group:'stress', value:'workoutheat', label:'Workout in heat', icon:'🏋', delta:+18, rise:0.5, decay:3.0, type:'stress' },
  { group:'stress', value:'dehydration', label:'Not enough water', icon:'💧', delta:+12, rise:0.6, decay:4.0, type:'stress' },
  { group:'stress', value:'badmeal', label:'Heavy meal / slump', icon:'🍔', delta:+7, rise:0.8, decay:2.5, type:'stress' },
  { group:'relief', value:'shade', label:'Shade / cool room', icon:'🌿', delta:-8, rise:0.3, decay:2.4, type:'relief' },
  { group:'relief', value:'coldshower', label:'Cold shower', icon:'🚿', delta:-7, rise:0.2, decay:1.2, type:'relief' },
  { group:'relief', value:'minerals', label:'Water + minerals', icon:'🧂', delta:-6, rise:0.4, decay:2.5, type:'relief' },
  { group:'relief', value:'breath', label:'Breathwork', icon:'💬', delta:-5, rise:0.3, decay:1.8, type:'relief' },
  { group:'relief', value:'nap', label:'Short rest', icon:'😴', delta:-9, rise:0.3, decay:2.0, type:'relief' },
  { group:'other', value:'alcoholpm', label:'Alcohol in evening', icon:'🍷', delta:+10, rise:1.5, decay:4.5, type:'neutral' },
  { group:'other', value:'screens', label:'Screens at night', icon:'📱', delta:+5, rise:0.4, decay:3.5, type:'neutral' },
];
const TYPE_COLOR = { stress:'#C4603A', relief:'#5C7A5E', neutral:'#B8962E' };
const ZONE_COLORS = { low:'#2a7d4f', optimal:'#185FA5', high:'#B8962E', critical:'#C4603A' };

let summerEvents = [], eventIdCounter = 0, currentHour = 13, lastCurve = BASE_CURVE.slice();

function fillEventOptions() {
  const select=document.getElementById('event-type-select');
  const grouped = {
    stress: copy.eventGroups.stress,
    relief: copy.eventGroups.relief,
    other: copy.eventGroups.other,
  };
  select.innerHTML = Object.entries(grouped).map(([key,label]) => {
    const options = EVENT_TYPES.filter(e=>e.group===key).map(e=>`<option value="${e.value}">${e.icon} ${e.label}</option>`).join('');
    return `<optgroup label="${label}">${options}</optgroup>`;
  }).join('');
}
function getBaseCurve(){
  const sleep = +document.getElementById('sleep').value;
  const hydration = +document.getElementById('hydration').value;
  const heat = +document.getElementById('heat').value;
  const alcohol = +document.getElementById('alcohol').value;
  const training = +document.getElementById('training').value;
  const nightPenalty = sleep*5 + alcohol*4;
  const hydrationPenalty = hydration*4;
  const heatPenalty = heat*6;
  const trainingPenalty = training*5;
  return BASE_CURVE.map((b,h)=>{
    let val=b + heatPenalty + hydrationPenalty*0.7;
    if(h <= 8) val += nightPenalty;
    if(h >= 10 && h <= 18) val += hydrationPenalty + heatPenalty*0.8 + trainingPenalty*0.4;
    if(h >= 18) val += alcohol*2 + trainingPenalty*0.5;
    return Math.min(100, Math.max(5, Math.round(val)));
  });
}
function computeCurve() {
  const base=getBaseCurve();
  const delta=new Array(24).fill(0);
  summerEvents.forEach(ev=>{
    const def=EVENT_TYPES.find(t=>t.value===ev.typeValue);
    if(!def)return;
    const peakH=ev.hour+def.rise;
    for(let h=0;h<24;h++){
      if(h<ev.hour)continue;
      let c=h<=peakH?def.delta*((h-ev.hour)/Math.max(def.rise,0.01)):def.delta*Math.exp(-(h-peakH)*Math.LN2/def.decay);
      delta[h]+=c;
    }
  });
  return base.map((b,i)=>Math.min(100, Math.max(0, Math.round(b+delta[i]))));
}
function getZone(v){
  if(v < 25)return'low';
  if(v < 50)return'optimal';
  if(v < 75)return'high';
  return'critical';
}
function valToGaugePct(v){ return Math.min(100, Math.max(0, v)); }
function getTipIdx(h){ if(h<5)return 0; if(h<8)return 1; if(h<11)return 2; if(h<17)return 3; return 4; }
function getEveningMessage(v){
  if(v <= 22)return copy.currentMessages.low;
  if(v <= 35)return copy.currentMessages.optimal;
  if(v <= 55)return copy.currentMessages.high;
  return copy.currentMessages.critical;
}

let summerChart;
function buildChart(curve) {
  if (typeof Chart === 'undefined') {
    const canvas = document.getElementById('summerChart');
    const fallback = document.createElement('div');
    fallback.className = 'h-full flex items-center justify-center border border-zinc-800 bg-zinc-900 text-zinc-500 text-sm text-center px-6';
    fallback.textContent = langCode === 'cs'
      ? 'Graf se nepodařilo načíst. Ostatní výpočet nástroje funguje dál.'
      : 'The chart failed to load. The rest of the tool still works.';
    canvas.replaceWith(fallback);
    return;
  }
  summerChart=new Chart(document.getElementById('summerChart'),{
    type:'line',
    data:{labels:labels24,datasets:[
      {label:'Summer load',data:curve,borderColor:'#5C7A5E',backgroundColor:'rgba(92,122,94,0.12)',borderWidth:2.5,fill:true,tension:0.4,pointRadius:0,pointHoverRadius:4,order:2},
      {label:'Comfort',data:Array(24).fill(35),borderColor:'rgba(42,125,79,0.4)',borderWidth:1,borderDash:[3,3],pointRadius:0,fill:false,order:4},
      {label:'Overload',data:Array(24).fill(60),borderColor:'rgba(184,150,46,0.5)',borderWidth:1.5,borderDash:[4,3],pointRadius:0,fill:false,order:3},
      {label:'Critical',data:Array(24).fill(80),borderColor:'rgba(196,96,58,0.6)',borderWidth:1.5,borderDash:[4,3],pointRadius:0,fill:false,order:3},
      {label:'Now',data:Array(24).fill(null),borderColor:'rgba(196,96,58,0.7)',borderWidth:2,borderDash:[5,4],pointRadius:0,fill:false,order:1},
      {label:'Events',data:Array(24).fill(null),borderColor:'transparent',backgroundColor:'transparent',pointRadius:Array(24).fill(0),fill:false,order:0}
    ]},
    options:{
      responsive:true,maintainAspectRatio:false,animation:{duration:350},
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=> c.datasetIndex===0 ? `${c.parsed.y.toFixed(0)} / 100` : null}}},
      scales:{
        x:{ticks:{maxTicksLimit:8,color:'#71717a',font:{size:10},autoSkip:true},grid:{color:'rgba(255,255,255,0.04)'}},
        y:{min:0,max:100,ticks:{color:'#71717a',font:{size:10},callback:v=>v},grid:{color:'rgba(255,255,255,0.04)'}}
      }
    }
  });
}
function updateNowLine(h){ if(!summerChart) return; const d=Array(24).fill(null);d[h]=100;summerChart.data.datasets[4].data=d;}
function updateEventDots(curve){
  if(!summerChart) return;
  const r=Array(24).fill(0),bg=Array(24).fill('transparent'),bc=Array(24).fill('transparent');
  summerEvents.forEach(ev=>{const def=EVENT_TYPES.find(t=>t.value===ev.typeValue);if(!def)return;r[ev.hour]=Math.max(r[ev.hour],7);bg[ev.hour]=TYPE_COLOR[def.type];bc[ev.hour]='white';});
  const dotData=Array(24).fill(null).map((_,i)=>r[i]>0?curve[i]:null);
  const ds=summerChart.data.datasets[5];
  ds.data=dotData; ds.pointRadius=r; ds.pointBackgroundColor=bg; ds.pointBorderColor=bc; ds.pointBorderWidth=Array(24).fill(2); ds.pointHoverRadius=r.map(x=>x+2);
}
function updateEvening(curve){
  const val=curve[20];
  const el=document.getElementById('evening-val'),bar=document.getElementById('evening-bar'),msg=document.getElementById('evening-msg');
  let color='#C4603A';
  if(val <= 22)color='#5C7A5E'; else if(val <= 35)color='#185FA5'; else if(val <= 55)color='#B8962E';
  el.textContent=`${val} / 100`; el.style.color=color;
  bar.style.width=Math.min(100,val)+'%'; bar.style.background=color;
  msg.textContent=getEveningMessage(val);
}
function updateAll(){
  const curve=computeCurve(); lastCurve=curve;
  if (summerChart) {
    summerChart.data.datasets[0].data=curve;
    updateNowLine(currentHour); updateEventDots(curve); summerChart.update();
  }
  const val=curve[currentHour], zone=getZone(val), col=ZONE_COLORS[zone], lbl=copy.zones[zone];
  document.getElementById('m-now').innerHTML=`${val} <span style="font-size:9px;padding:1px 6px;background:${col}25;color:${col};font-family:sans-serif;letter-spacing:0.06em;text-transform:uppercase;">${lbl}</span>`;
  document.getElementById('m-peak').textContent=Math.max(...curve).toFixed(0);
  document.getElementById('m-evening').textContent=curve[20].toFixed(0);
  document.getElementById('m-phase').textContent=PHASES[currentHour];
  document.getElementById('phase-tip').textContent=copy.phaseTips[getTipIdx(currentHour)];
  document.getElementById('gauge-marker').style.left=valToGaugePct(val)+'%';
  updateEvening(curve);
  const panel=document.getElementById('intervention-panel');
  if(zone==='low' || zone==='optimal'){ panel.style.display='none'; return; }
  panel.style.display='block';
  const hdr=document.getElementById('intv-header'),icon=document.getElementById('intv-icon'),title=document.getElementById('intv-title'),sub=document.getElementById('intv-sub'),tags=document.getElementById('intv-tags');
  const isCritical = zone==='critical';
  hdr.style.background=isCritical ? 'rgba(196,96,58,0.12)' : 'rgba(184,150,46,0.12)';
  icon.style.background=isCritical ? '#C4603A' : '#B8962E';
  title.style.color=isCritical ? '#C4603A' : '#B8962E';
  title.textContent = isCritical ? copy.interventions.criticalTitle : copy.interventions.highTitle;
  sub.textContent = isCritical ? copy.interventions.criticalSub : copy.interventions.highSub;
  const items = [
    {label:copy.interventionTags.cool,dot:'#5C7A5E'},
    {label:copy.interventionTags.water,dot:'#185FA5'},
    {label:copy.interventionTags.breath,dot:'#5C7A5E'},
    {label:copy.interventionTags.rest,dot:'#B8962E'},
    ...(isCritical ? [{label:copy.interventionTags.consult,dot:'#C4603A'}] : [{label:copy.interventionTags.redlight,dot:'#B8962E'}])
  ];
  tags.innerHTML=items.map(i=>`<span class="s-tag"><span class="s-tag-dot" style="background:${i.dot}"></span>${i.label}</span>`).join('');
}

window.addSummerEventFromUI=function(){
  const typeValue=document.getElementById('event-type-select').value;
  const hour=Math.min(23,Math.max(0,+document.getElementById('event-hour-input').value));
  summerEvents.push({id:++eventIdCounter,hour,typeValue});renderEvents();updateAll();
};
window.removeSummerEvent=function(id){summerEvents=summerEvents.filter(e=>e.id!==id);renderEvents();updateAll();};
window.updateSummerEventHour=function(id,val){const ev=summerEvents.find(e=>e.id===id); if(ev){ev.hour=Math.min(23,Math.max(0,+val)); updateAll();}};
function renderEvents(){
  const list=document.getElementById('summer-events-list');
  if(summerEvents.length===0){list.innerHTML=`<p class="text-[11px] text-zinc-400 leading-relaxed py-2">${copy.noEvents}</p>`;return;}
  list.innerHTML=summerEvents.map(ev=>{
    const def=EVENT_TYPES.find(t=>t.value===ev.typeValue);
    const col=def?TYPE_COLOR[def.type]:'#888';
    const sign=def&&def.delta>0?'+':'';
    return `<div class="s-event-row">
      <div class="s-event-bar" style="background:${col};"></div>
      <input type="number" min="0" max="23" value="${ev.hour}" class="s-event-hour" title="Event hour" onchange="updateSummerEventHour(${ev.id},this.value)" style="border-color:${col}60;color:#f4f4f5;-webkit-text-fill-color:#f4f4f5;">
      <span class="s-event-label"><span style="color:#f4f4f5;-webkit-text-fill-color:#f4f4f5;">${def?def.icon+' '+def.label:'—'}</span> <span style="color:${col};font-size:10px;">${sign}${def?def.delta:0}</span></span>
      <button class="s-event-del" onclick="removeSummerEvent(${ev.id})">×</button>
    </div>`;
  }).join('');
}

['sleep','hydration','heat','alcohol','training'].forEach(id=>document.getElementById(id).addEventListener('change',updateAll));
document.getElementById('hour-slider').addEventListener('input',function(){
  currentHour=+this.value; document.getElementById('hour-out').textContent=String(currentHour).padStart(2,'0')+':00'; updateAll();
});
document.getElementById('lead-form').addEventListener('submit',function(){
  document.getElementById('f-load-now').value=lastCurve[currentHour];
  document.getElementById('f-load-evening').value=lastCurve[20];
  document.getElementById('f-events').value=JSON.stringify(summerEvents.map(e=>({type:e.typeValue,hour:e.hour})));
});

fillEventOptions();
buildChart(computeCurve());
updateNowLine(currentHour);
renderEvents();
updateAll();
</script>

<script>
  const observer = new IntersectionObserver(
    (entries) => { entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); }); },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) { el.classList.add('visible'); } else { observer.observe(el); }
  });
</script>
