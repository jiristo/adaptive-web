---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const photos = [
  { img: '/images/kapka-resort-exterier.jpg', alt: 'Kapka Resort' },
  { img: '/images/kapka-kryokomora.jpg', alt: t('studioFeatureKryoTitle') },
  { img: '/images/kapka-fitness.jpg', alt: t('studioFeatureFitnessTitle') },
  { img: '/images/kapka-wellness.jpg', alt: t('studioFeatureWellnessTitle') },
];

const features = [
  { titleKey: 'studioFeatureKryoTitle', bodyKey: 'studioFeatureKryoBody' },
  { titleKey: 'studioFeatureFitnessTitle', bodyKey: 'studioFeatureFitnessBody' },
  { titleKey: 'studioFeatureWellnessTitle', bodyKey: 'studioFeatureWellnessBody' },
] as const;
---

<div
  id="studio-modal"
  class="fixed inset-0 z-[300] bg-[#111110] flex flex-col opacity-0 pointer-events-none transition-opacity duration-300"
  aria-modal="true"
  role="dialog"
  aria-label={t('navStudio')}
>
  <!-- Header -->
  <div class="flex items-center justify-between px-6 sm:px-10 lg:px-20 py-8 border-b border-zinc-800 shrink-0">
    <h2 class="font-heading text-4xl sm:text-5xl font-bold text-white tracking-tight">
      {t('navStudio')}
    </h2>
    <button
      id="studio-close"
      class="text-zinc-500 hover:text-white transition-colors duration-200 p-1"
      aria-label={t('studioClose')}
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Location -->
  <div class="px-6 sm:px-10 lg:px-20 pt-10 border-b border-zinc-800 pb-10">
    <p class="text-[10px] tracking-[0.35em] uppercase text-sage mb-4">{t('studioLocationTag')}</p>
    <h3 class="font-heading text-2xl sm:text-3xl font-bold text-white tracking-tight mb-5">
      {t('studioLocationHeading')}
    </h3>
    <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mb-8">
      {t('studioLocationBody')}
    </p>

    <div class="grid sm:grid-cols-3 gap-6 mb-8 max-w-4xl">
      {features.map((f) => (
        <div>
          <p class="text-sm font-semibold text-white mb-2">{t(f.titleKey)}</p>
          <p class="text-zinc-400 text-xs leading-relaxed">{t(f.bodyKey)}</p>
        </div>
      ))}
    </div>

    <a
      href="https://www.kapkaresort.cz/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-[11px] tracking-[0.2em] uppercase text-white hover:text-sage transition-colors duration-200 font-semibold"
    >
      {t('studioLocationLinkText')}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <!-- Photo grid -->
  <div class="flex-1 overflow-y-auto px-6 sm:px-10 lg:px-20 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {photos.map((p) => (
        <div class="relative aspect-[4/3] overflow-hidden bg-zinc-900">
          <img src={p.img} alt={p.alt} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('studio-modal');
  const closeBtn = document.getElementById('studio-close');
  let historyPushed = false;

  function isOpen() {
    return modal && !modal.classList.contains('opacity-0');
  }

  function openModal() {
    modal?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
    history.pushState({ studioOpen: true }, '');
    historyPushed = true;
  }

  function closeModal(fromHistory = false) {
    if (!isOpen()) return;
    modal?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
    if (!fromHistory && historyPushed) {
      historyPushed = false;
      history.back();
    } else {
      historyPushed = false;
    }
  }

  document.querySelectorAll('[data-studio-open]').forEach((el) => {
    el.addEventListener('click', openModal);
  });

  closeBtn?.addEventListener('click', () => closeModal(false));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal(false);
  });

  window.addEventListener('popstate', () => {
    if (isOpen()) closeModal(true);
  });
</script>
