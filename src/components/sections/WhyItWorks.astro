---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-white py-32 md:py-44 px-6 sm:px-10 lg:px-20">
  <div class="grid lg:grid-cols-2 gap-16 lg:gap-32 items-start">

    <div class="reveal">
      <div class="flex items-center gap-4 mb-12">
        <span class="block h-px w-8 bg-sage"></span>
        <p class="text-[10px] font-medium tracking-[0.4em] uppercase text-sage">
          {t('whyTag')}
        </p>
      </div>
      <h2 class="font-heading text-4xl sm:text-5xl md:text-[3.5rem] font-bold leading-[0.95] tracking-tight text-zinc-900">
        {t('whyH2')}
      </h2>
    </div>

    <div class="space-y-7 reveal reveal-delay-1">
      <p class="text-zinc-600 text-base leading-relaxed">
        {t('whyP1')}
      </p>
      <p class="text-zinc-600 text-base leading-relaxed">
        {t('whyP2')}
      </p>
      <p class="font-heading text-xl font-semibold text-zinc-900 border-l-2 border-sage pl-5">
        {t('whyP3')}
      </p>
    </div>

  </div>
</section>
