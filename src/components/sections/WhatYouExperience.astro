---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const cs = {
  heading: 'Co konkrétně u nás zažijete.',
  ctaLabel: 'Zarezervovat konzultaci',
  ctaHref: '/preview/#booking',
  items: [
    {
      tag: 'Regenerace',
      title: 'Odpočinete si — opravdově',
      body: 'Červené světlo a kryokomora nejsou jen příjemný doplněk. Pomáhají tělu rychleji se zklidnit, uvolnit a nastartovat obnovu. Odejdete s pocitem úlevy, který tělo dobře pozná.',
      imgAlt: 'Regenerace',
    },
    {
      tag: 'Dechová práce',
      title: 'Naučíte se pracovat s dechem',
      body: 'Dech je jeden z nejrychlejších způsobů, jak ovlivnit vlastní stav. Odnesete si jednoduchý postup, který můžete použít hned, kdykoliv budete potřebovat zklidnění nebo soustředění.',
      imgAlt: 'Dechová práce',
    },
    {
      tag: 'Vědomý pohyb',
      title: 'Pohnete tělem záměrně',
      body: 'Silový trénink u nás není jen o výkonu. Učíte se lépe vnímat tělo, pohybovat se přesněji a zapojovat správné svaly ve správný čas.',
      imgAlt: 'Vědomý pohyb',
    },
    {
      tag: 'Meditace a protažení',
      title: 'Zpomalíte — vědomě',
      body: 'Klid není náhoda, ale dovednost. Vedená meditace a protažení vám pomohou poznat, kdy se tělo opravdu uvolňuje, a naučí vás do tohoto stavu vracet i mimo studio.',
      imgAlt: 'Meditace a protažení',
    },
  ],
};

const en = {
  heading: 'What you will experience with us.',
  ctaLabel: 'Book a consultation',
  ctaHref: '/en/preview/#booking',
  items: [
    {
      tag: 'Recovery',
      title: 'You will truly rest',
      body: 'Red light therapy and cryotherapy are more than pleasant add-ons. They help the body settle faster, release tension and begin recovery. You leave with a sense of relief your body clearly recognises.',
      imgAlt: 'Recovery',
    },
    {
      tag: 'Breathwork',
      title: 'You will learn to work with your breath',
      body: 'Breath is one of the fastest ways to influence your state. You will leave with a simple method you can use right away whenever you need calm or focus.',
      imgAlt: 'Breathwork',
    },
    {
      tag: 'Conscious movement',
      title: 'You will move with intention',
      body: 'Our strength training is not just about performance. You learn to feel your body more clearly, move with more precision and engage the right muscles at the right time.',
      imgAlt: 'Conscious movement',
    },
    {
      tag: 'Meditation & stretching',
      title: 'You will slow down — consciously',
      body: 'Calm is not an accident. It is a skill. Guided meditation and stretching help you recognise when the body is truly letting go and teach you how to return to that state outside the studio too.',
      imgAlt: 'Meditation & stretching',
    },
  ],
};

const content = lang === 'cs' ? cs : en;
const paddings = ['lg:pr-8', 'lg:px-8', 'lg:px-8', 'lg:pl-8'];
const delays = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3', 'reveal-delay-4'];
---

<section class="min-h-screen bg-[#111110] flex flex-col px-6 sm:px-10 lg:px-20 py-24">

  <div class="mb-16 reveal">
    <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white">
      {content.heading}
    </h2>
  </div>

  <div class="flex-1 grid md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-0 md:divide-x divide-zinc-800">

    {content.items.map((item, i) => (
      <div class={`flex flex-col ${paddings[i]} reveal ${delays[i]}`}>

        <div class="mb-8">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">{item.tag}</p>
          <h3 class="font-heading text-2xl font-bold text-white tracking-tight mb-4">{item.title}</h3>
          <p class="text-zinc-300 text-sm leading-relaxed max-w-xs">{item.body}</p>
        </div>

        <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-900 mt-auto mb-8">
          <div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-sage opacity-50"></div>
          <div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-sage opacity-50"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <p class="text-[9px] tracking-[0.3em] text-zinc-600 uppercase">{item.imgAlt}</p>
          </div>
        </div>

        <a
          href={content.ctaHref}
          class="inline-flex items-center gap-2 text-[10px] tracking-[0.2em] uppercase text-zinc-500 hover:text-white transition-colors duration-200"
        >
          {content.ctaLabel} <span aria-hidden="true">→</span>
        </a>

      </div>
    ))}

  </div>

</section>
