---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-32">
  <div class="grid lg:grid-cols-[1fr_0.45fr] gap-20 lg:gap-32 items-center w-full">

    <div class="reveal">
      <p class="text-xs sm:text-sm tracking-[0.35em] uppercase font-semibold text-sage mb-12">
        {t('heroTag')}
      </p>

      <h1 class="font-heading font-bold leading-[0.88] tracking-tight text-zinc-900 mb-10"
          style="font-size: clamp(3.5rem, 10vw, 8rem)">
        {t('heroH1')}<br>
        <span class="text-zinc-300 font-light">{t('heroH1b')}</span>
      </h1>

      <p class="text-zinc-500 text-base md:text-lg max-w-md leading-relaxed mb-14">
        {t('heroBody')}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#booking"
           class="inline-flex items-center justify-center px-8 py-4 bg-zinc-900 text-white text-xs font-semibold tracking-[0.15em] uppercase hover:bg-zinc-700 transition-colors duration-200">
          {t('heroCta')}
        </a>
        <a href="#how-it-works"
           class="inline-flex items-center justify-center gap-2 px-8 py-4 text-xs font-semibold tracking-[0.15em] uppercase text-zinc-500 border border-zinc-200 hover:border-zinc-900 hover:text-zinc-900 transition-colors duration-200">
          {t('heroSecondary')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="reveal reveal-delay-2 hidden lg:flex flex-col">
      <div class="relative w-full aspect-[3/4] bg-zinc-100 overflow-hidden">
        <!-- Replace: <img src="/images/jiri-stodulka.jpg" alt="Jiří J. Stodůlka" class="w-full h-full object-cover" /> -->
        <div class="absolute top-0 left-0 w-8 h-8 border-t border-l border-sage"></div>
        <div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-sage"></div>
        <div class="absolute bottom-4 right-4 text-[8px] tracking-[0.3em] text-zinc-400 uppercase">foto</div>
      </div>
    </div>

  </div>
</section>
