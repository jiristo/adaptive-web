---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// TODO: Replace with Calendly or other booking provider URL
const CALENDLY_URL = 'https://calendly.com/jiri-adaptivestudio/30min';
---

<section id="booking" class="min-h-screen flex flex-col items-center justify-center px-6 text-center py-32">

  <div class="reveal">
    <h2 class="font-heading font-bold leading-tight tracking-tight text-zinc-900 mb-8"
        style="font-size: clamp(2.5rem, 7vw, 5rem)">
      {t('ctaH2')}
    </h2>

    <p class="text-zinc-500 text-sm leading-relaxed mb-3 max-w-sm mx-auto">
      {t('ctaBody')}
    </p>
    <p class="text-zinc-400 text-xs mb-14">{t('ctaNote')}</p>

    <a href={CALENDLY_URL}
       class="inline-flex items-center justify-center px-12 py-5 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200">
      {t('ctaButton')}
    </a>
  </div>

</section>
