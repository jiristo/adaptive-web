---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="min-h-screen bg-[#111110] flex items-center px-6 sm:px-10 lg:px-20 py-32">
  <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center w-full">

    <!-- Left: text -->
    <div class="reveal">
      <h2 class="font-heading font-bold leading-[0.92] tracking-tight text-white mb-8"
          style="font-size: clamp(2.5rem, 7vw, 6rem)">
        {t('problemP1').split('.')[0]}.<br>
        <span class="text-zinc-500 font-light">{t('problemP1').split('.')[1]?.trim()}.</span>
      </h2>

      <p class="text-zinc-400 text-base md:text-lg leading-relaxed max-w-xl mt-12 border-l border-sage pl-6">
        {t('problemP3')}
      </p>
    </div>

    <!-- Right: image -->
    <div class="reveal reveal-delay-2 relative w-full aspect-[3/2] overflow-hidden">
      <img
        src="/images/burnout-professional-man.webp"
        alt="Vyčerpaný profesionál — přetížení nervového systému"
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute top-0 left-0 w-8 h-8 border-t border-l border-sage opacity-40"></div>
      <div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-sage opacity-40"></div>
    </div>

  </div>
</section>
