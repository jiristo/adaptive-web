---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = lang === 'cs' ? '/preview/kontakt/' : '/en/preview/kontakt/';

const socials = [
  {
    label: 'Instagram',
    href: '#',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    label: 'Facebook',
    href: '#',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: '#',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    label: 'YouTube',
    href: '#',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>`,
  },
];
---

<footer class="border-t border-zinc-100 px-6 sm:px-10 lg:px-20 pt-10 pb-20">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <span class="font-heading font-semibold text-sm tracking-[0.2em] uppercase text-zinc-900">
      Adaptive Studio
    </span>
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 text-[11px] text-zinc-400 tracking-wide items-start sm:items-center">
      <a href={contactHref} class="hover:text-zinc-900 transition-colors duration-200">Kontakt</a>
      <div class="flex items-center gap-4">
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            class="text-zinc-400 hover:text-zinc-900 transition-colors duration-200"
            set:html={s.icon}
          />
        ))}
      </div>
      <span>{t('footerLocation')}</span>
      <span>{t('footerCopyright')}</span>
    </div>
  </div>
</footer>
