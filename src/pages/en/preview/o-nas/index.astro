---
import Layout from '../../../../layouts/Layout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import StudioModal from '../../../../components/StudioModal.astro';
---

<Layout
  title="About Us — Adaptive Studio"
  description="Mission, vision and the team behind Adaptive Studio. Find out who we are and what drives us."
  lang="en"
>
  <StudioModal lang="en" />
  <Nav lang="en" />

  <main>

    <!-- Hero -->
    <section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-10">ADAPTIVE STUDIO</p>
      <h1 class="font-heading font-bold leading-[0.9] tracking-tight text-zinc-900 mb-10 reveal"
          style="font-size: clamp(4rem, 12vw, 10rem)">
        About Us
      </h1>
      <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-xl reveal reveal-delay-1">
        We are not just a studio.<br>
        We are a team and a thoughtful approach built on the belief that the ability to recover is not a luxury, but a basic part of a well-functioning life.
      </p>
    </section>

    <!-- Mission & Vision — dark -->
    <section class="min-h-screen bg-[#111110] flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">

      <div class="grid lg:grid-cols-2 gap-20 lg:gap-32">

        <div class="flex flex-col reveal">
          <h2 class="font-heading font-bold text-white leading-none tracking-tight mb-6"
              style="font-size: clamp(4rem, 8vw, 7rem)">Mission</h2>
          <p class="text-white text-xl sm:text-2xl font-light leading-snug mb-6 max-w-md">
            To help people work better with their body, stress and recovery.
          </p>
          <p class="text-zinc-400 text-sm leading-relaxed max-w-md mb-10">
            Stress is part of life. The problem begins when a person cannot return from it back into calm. We want to give people clear tools and an environment where they can learn to handle both effort and recovery better.
          </p>
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-900 mt-auto">
            <!-- Replace: <img src="/images/mise.jpg" alt="Adaptive Studio Mission" class="w-full h-full object-cover" /> -->
            <div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-sage opacity-50"></div>
            <div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-sage opacity-50"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <p class="text-[9px] tracking-[0.3em] text-zinc-600 uppercase">photo</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col reveal reveal-delay-1">
          <h2 class="font-heading font-bold text-white leading-none tracking-tight mb-6"
              style="font-size: clamp(4rem, 8vw, 7rem)">Vision</h2>
          <p class="text-white text-xl sm:text-2xl font-light leading-snug mb-6 max-w-md">
            A studio where a strong body and a calm mind are not opposites.
          </p>
          <p class="text-zinc-400 text-sm leading-relaxed max-w-md mb-10">
            We want to be a place where important skills are actually trained. Clearly, honestly and in a way that leaves people with something they can use in everyday life, not just a good feeling.
          </p>
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-900 mt-auto">
            <!-- Replace: <img src="/images/vize.jpg" alt="Adaptive Studio Vision" class="w-full h-full object-cover" /> -->
            <div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-sage opacity-50"></div>
            <div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-sage opacity-50"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <p class="text-[9px] tracking-[0.3em] text-zinc-600 uppercase">photo</p>
            </div>
          </div>
        </div>

      </div>

    </section>

    <!-- Team — light -->
    <section class="min-h-screen flex flex-col px-6 sm:px-10 lg:px-20 py-24">

      <div class="mb-12 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">TEAM</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
          The people behind Adaptive Studio.
        </h2>
      </div>

      <div class="flex-1 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">

        <!-- Jiří -->
        <div class="flex flex-col reveal reveal-delay-1">
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-100 mb-5">
            <!-- Replace: <img src="/images/jiri-stodulka.jpg" alt="Jiří J. Stodůlka" class="w-full h-full object-cover" /> -->
            <div class="absolute top-0 left-0 w-5 h-5 border-t border-l border-sage"></div>
            <div class="absolute bottom-0 right-0 w-5 h-5 border-b border-r border-sage"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <p class="text-[9px] tracking-[0.3em] text-zinc-400 uppercase">photo</p>
            </div>
          </div>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-2">FOUNDER & TRAINER</p>
          <h3 class="font-heading text-lg font-bold text-zinc-900 tracking-tight mb-3">Jiří J. Stodůlka</h3>
          <p class="text-zinc-500 text-xs leading-relaxed mb-4">
            Founder of the studio and creator of its approach. He brought together knowledge of how the body works, conscious movement and personal experience with burnout into a system that helps people handle both effort and recovery more effectively.
          </p>
          <a
            href="/en/preview/pribeh/"
            class="inline-flex items-center gap-2 text-[10px] tracking-[0.2em] uppercase text-zinc-500 hover:text-zinc-900 transition-colors duration-200"
          >
            Full story <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- DNS Trainer -->
        <div class="flex flex-col reveal reveal-delay-2">
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-50 mb-5">
            <div class="absolute top-0 left-0 w-5 h-5 border-t border-l border-zinc-200"></div>
            <div class="absolute bottom-0 right-0 w-5 h-5 border-b border-r border-zinc-200"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <p class="text-[9px] tracking-[0.3em] text-zinc-300 uppercase">photo</p>
            </div>
          </div>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-zinc-300 mb-2">WE'RE HIRING</p>
          <h3 class="font-heading text-lg font-bold text-zinc-900 tracking-tight mb-3">DNS Trainer</h3>
          <p class="text-zinc-400 text-xs leading-relaxed">
            A movement specialist with experience helping people after injury or long-term overload.
          </p>
        </div>

        <!-- Rehabilitation Trainer -->
        <div class="flex flex-col reveal reveal-delay-3">
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-50 mb-5">
            <div class="absolute top-0 left-0 w-5 h-5 border-t border-l border-zinc-200"></div>
            <div class="absolute bottom-0 right-0 w-5 h-5 border-b border-r border-zinc-200"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <p class="text-[9px] tracking-[0.3em] text-zinc-300 uppercase">photo</p>
            </div>
          </div>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-zinc-300 mb-2">WE'RE HIRING</p>
          <h3 class="font-heading text-lg font-bold text-zinc-900 tracking-tight mb-3">Rehabilitation Trainer</h3>
          <p class="text-zinc-400 text-xs leading-relaxed">
            A physiotherapist or recovery specialist who understands the connection between movement, overload and the way the body responds to stress.
          </p>
        </div>

        <!-- Therapist -->
        <div class="flex flex-col reveal reveal-delay-4">
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-zinc-50 mb-5">
            <div class="absolute top-0 left-0 w-5 h-5 border-t border-l border-zinc-200"></div>
            <div class="absolute bottom-0 right-0 w-5 h-5 border-b border-r border-zinc-200"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <p class="text-[9px] tracking-[0.3em] text-zinc-300 uppercase">photo</p>
            </div>
          </div>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-zinc-300 mb-2">WE'RE HIRING</p>
          <h3 class="font-heading text-lg font-bold text-zinc-900 tracking-tight mb-3">Therapist</h3>
          <p class="text-zinc-400 text-xs leading-relaxed">
            A therapist who works sensitively with both the body and emotional experience, and believes that resilience grows from the ability to return to safety and calm.
          </p>
        </div>

      </div>

    </section>

    <!-- CTA -->
    <section class="min-h-[50vh] bg-[#111110] flex flex-col items-center justify-center px-6 text-center py-24">
      <div class="reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-8">FIRST STEP</p>
        <h2 class="font-heading font-bold leading-tight tracking-tight text-white mb-8"
            style="font-size: clamp(2rem, 6vw, 4rem)">
          Want to handle stress and recovery better?
        </h2>
        <a
          href="https://calendly.com/jiri-adaptivestudio/30min"
          class="inline-flex items-center justify-center px-12 py-5 bg-white text-zinc-900 text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-100 transition-colors duration-200"
        >
          Book a consultation
        </a>
      </div>
    </section>

  </main>

  <Footer lang="en" />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('visible');
    } else {
      observer.observe(el);
    }
  });
</script>
