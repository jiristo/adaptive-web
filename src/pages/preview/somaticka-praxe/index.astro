---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import StudioModal from '../../../components/StudioModal.astro';
---

<Layout
  title="Somatická praxe — Pilíře přístupu · Adaptive Studio"
  description="Tělo jako vstupní bod. Somatické přístupy k regulaci nervového systému skrze pohyb, dech a fyzické vjemy."
  lang="cs"
>
  <StudioModal lang="cs" />
  <Nav lang="cs" />

  <main>

    <section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-10">PILÍŘ 03</p>
      <h1 class="font-heading font-bold leading-[0.9] tracking-tight text-zinc-900 mb-10 reveal"
          style="font-size: clamp(3rem, 9vw, 8rem)">
        Somatická<br>Praxe
      </h1>
      <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-xl reveal reveal-delay-1">
        Tělo jako vstupní bod.<br>
        <span class="text-sm text-zinc-400">Pohyb, dech a fyzické vjemy jako nástroj regulace.</span>
      </p>
    </section>

    <section class="bg-[#111110] px-6 sm:px-10 lg:px-20 py-24">
      <div class="max-w-2xl reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-12">OBSAH</p>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-8">
          TODO — Název kapitoly
        </h2>
        <div class="space-y-6 text-zinc-400 text-sm leading-relaxed">
          <p>TODO — Zde doplň obsah o somatické praxi a jejích technikách.</p>
        </div>
      </div>
    </section>

    <section class="min-h-[50vh] flex flex-col items-center justify-center px-6 text-center py-24">
      <div class="reveal">
        <a href="/preview/sluzby/" class="inline-flex items-center gap-2 text-[10px] tracking-[0.2em] uppercase text-zinc-400 hover:text-zinc-900 transition-colors duration-200 mb-10">
          <span aria-hidden="true">←</span> Zpět na Přístup
        </a>
        <h2 class="font-heading font-bold leading-tight tracking-tight text-zinc-900 mb-8"
            style="font-size: clamp(2rem, 6vw, 4rem)">
          Chceš začít trénovat regulaci?
        </h2>
        <a
          href="https://calendly.com/jiri-adaptivestudio/30min"
          class="inline-flex items-center justify-center px-12 py-5 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200"
        >
          Zarezervovat konzultaci
        </a>
      </div>
    </section>

  </main>

  <Footer lang="cs" />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => { entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); }); },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => {
    el.getBoundingClientRect().top < window.innerHeight ? el.classList.add('visible') : observer.observe(el);
  });
</script>
