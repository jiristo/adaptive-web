---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import StudioModal from '../../../components/StudioModal.astro';
---

<Layout
  title="Celý příběh — Jiří J. Stodůlka · Adaptive Studio"
  description="Osobní příběh zakladatele Adaptive Studia. Od vozíčku přes sport, vyhoření až po metodiku regulace nervového systému."
  lang="cs"
>
  <StudioModal lang="cs" />
  <Nav lang="cs" />

  <main>

    <!-- Hero -->
    <section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-10">PŘÍBĚH ZAKLADATELE</p>
      <h1 class="font-heading font-bold leading-[0.9] tracking-tight text-zinc-900 mb-10 reveal"
          style="font-size: clamp(4rem, 12vw, 10rem)">
        Celý příběh
      </h1>
      <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-xl reveal reveal-delay-1">
        Jiří J. Stodůlka<br>
        <span class="text-sm text-zinc-400">Zakladatel, Adaptive Studio</span>
      </p>
    </section>

    <!-- Story — dark, long-form text -->
    <section class="bg-[#111110] px-6 sm:px-10 lg:px-20 py-24">
      <div class="max-w-2xl reveal">

        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-12">KAPITOLA 01</p>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white tracking-tight mb-8">
          TODO — Název kapitoly
        </h2>
        <div class="space-y-6 text-zinc-400 text-sm leading-relaxed">
          <p>TODO — Zde doplň text příběhu.</p>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="min-h-[50vh] flex flex-col items-center justify-center px-6 text-center py-24">
      <div class="reveal">
        <h2 class="font-heading font-bold leading-tight tracking-tight text-zinc-900 mb-8"
            style="font-size: clamp(2rem, 6vw, 4rem)">
          Chceš začít trénovat regulaci?
        </h2>
        <a
          href="/preview/#booking"
          class="inline-flex items-center justify-center px-12 py-5 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200"
        >
          Zarezervovat konzultaci
        </a>
      </div>
    </section>

  </main>

  <Footer lang="cs" />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('visible');
    } else {
      observer.observe(el);
    }
  });
</script>
