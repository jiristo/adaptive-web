<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<script is:inline>
const BASE_CURVE = [7,6,5,5,6,10,18,30,28,24,20,17,15,14,13,12,11,10,9,8,7,6,5,5];

const EVENT_TYPES = [
  { value:'conflict',    label:'Hádka / konflikt',         icon:'⚡', delta:+18, rise:0.3, decay:2.5, type:'stress'   },
  { value:'deadline',    label:'Deadline / prezentace',    icon:'📌', delta:+14, rise:0.5, decay:2.0, type:'stress'   },
  { value:'badnews',     label:'Špatná zpráva',            icon:'📰', delta:+12, rise:0.4, decay:3.0, type:'stress'   },
  { value:'publicsp',    label:'Veřejné vystoupení',       icon:'🎤', delta:+16, rise:0.3, decay:2.0, type:'stress'   },
  { value:'hiit',        label:'Intenzivní trénink',       icon:'🏋', delta:+20, rise:0.5, decay:1.5, type:'stress'   },
  { value:'traffic',     label:'Stres v dopravě',          icon:'🚗', delta:+8,  rise:0.2, decay:1.5, type:'stress'   },
  { value:'coldshower',  label:'Studená sprcha',           icon:'🚿', delta:+10, rise:0.1, decay:0.8, type:'stress'   },
  { value:'overload',    label:'Přetížení / multitasking', icon:'📋', delta:+11, rise:0.6, decay:2.5, type:'stress'   },
  { value:'cryo',        label:'Kryokomora',               icon:'❄',  delta:-14, rise:0.2, decay:1.0, type:'positive' },
  { value:'redlight',    label:'Červené světlo',           icon:'🔴', delta:-6,  rise:0.5, decay:2.0, type:'positive' },
  { value:'breathwork',  label:'Dechová práce',            icon:'💬', delta:-8,  rise:0.2, decay:1.2, type:'positive' },
  { value:'yoga',        label:'Jóga / meditace',          icon:'🧘', delta:-7,  rise:0.7, decay:2.0, type:'positive' },
  { value:'walk',        label:'Procházka v přírodě',      icon:'🚶', delta:-5,  rise:0.5, decay:2.0, type:'positive' },
  { value:'nap',         label:'Krátký spánek (20 min)',   icon:'😴', delta:-9,  rise:0.3, decay:1.5, type:'positive' },
  { value:'social',      label:'Příjemné setkání',         icon:'🤝', delta:-4,  rise:0.5, decay:2.0, type:'positive' },
  { value:'caffeine_am', label:'Káva ráno (do 11:00)',     icon:'☕', delta:+4,  rise:0.3, decay:1.5, type:'neutral'  },
  { value:'caffeine_pm', label:'Káva po 14:00',            icon:'☕', delta:+7,  rise:0.3, decay:4.5, type:'neutral'  },
  { value:'alcohol',     label:'Alkohol (večer)',          icon:'🍷', delta:+9,  rise:2.0, decay:4.0, type:'neutral'  },
  { value:'skippedmeal', label:'Vynechané jídlo',          icon:'🍽', delta:+7,  rise:1.0, decay:3.0, type:'neutral'  },
  { value:'screen',      label:'Obrazovky před spaním',    icon:'📱', delta:+5,  rise:0.5, decay:3.0, type:'neutral'  },
];

const TYPE_COLOR = { stress:'#C4603A', positive:'#5C7A5E', neutral:'#B8962E' };

const PHASES = ["Hluboký spánek","Hluboký spánek","Hluboký spánek","Hluboký spánek","Příprava na probuzení","Příprava na probuzení","Ranní vrchol","Ranní vrchol","Ranní aktivita","Dopoledne — výkon","Dopoledne — výkon","Poledne","Odpoledne","Odpoledne","Mírný pokles","Odpoledne","Večerní pokles","Večerní pokles","Večer","Večer","Noční odpočinek","Noční odpočinek","Noční odpočinek","Noční odpočinek"];

const TIPS = [
  "Kortizol je na minimu — tělo se hluboce regeneruje.",
  "Tělo se připravuje na probuzení. Kortizol pomalu stoupá.",
  "Ranní maximum (CAR) — výborný čas na náročné úkoly a rozhodnutí.",
  "Stále vysoké hladiny — využijte na kreativní práci a plánování.",
  "Dopolední výkonnostní okno — soustředění, analýza, jednání.",
  "Hladina klesá — ideální pro lehčí jídlo a krátkou procházku.",
  "Odpolední pokles — administrativní úkoly, lehčí práce.",
  "Kortizol klesá — čas na zklidnění, vyhněte se stresorům.",
  "Nízký kortizol — připravte se na spánek, omezte obrazovky.",
  "Noční minimum — regenerační procesy probíhají naplno."
];

const ZONE_COLORS = { low:'#2a7d4f', optimal:'#185FA5', high:'#C4603A' };
const ZONE_LABELS = { low:'Nízká', optimal:'V normě', high:'Vysoká' };

const INTERVENTIONS = {
  elevated: [{label:'Dechová práce',dot:'#5C7A5E'},{label:'Procházka',dot:'#5C7A5E'},{label:'Červené světlo',dot:'#B8962E'},{label:'Meditace',dot:'#5C7A5E'}],
  high:     [{label:'Kryokomora',dot:'#185FA5'},{label:'Nervový trénink',dot:'#C4603A'},{label:'Dechová práce',dot:'#5C7A5E'},{label:'Konzultace — Adaptive Studio',dot:'#C4603A'}]
};

let events = [], eventIdCounter = 0, currentHour = 8, lastCurve = BASE_CURVE.slice();

function getTipIdx(h) {
  if(h<4)return 0;if(h<6)return 1;if(h<8)return 2;if(h<10)return 3;
  if(h<12)return 4;if(h<14)return 5;if(h<17)return 6;if(h<20)return 7;
  if(h<22)return 8;return 9;
}
function getExpectedBand(baseCurve, hour) {
  const expected = baseCurve[hour];
  let low;
  let high;
  let floor;
  let ceil;

  if (hour <= 4) {
    low = 4;
    high = 8;
    floor = 3;
    ceil = 10;
  } else if (hour <= 6) {
    low = 6;
    high = 16;
    floor = 4;
    ceil = 19;
  } else if (hour <= 9) {
    low = 20;
    high = 36;
    floor = 14;
    ceil = 42;
  } else if (hour <= 13) {
    low = 12;
    high = 26;
    floor = 8;
    ceil = 31;
  } else if (hour <= 17) {
    low = 8;
    high = 18;
    floor = 5;
    ceil = 22;
  } else if (hour <= 20) {
    low = 5;
    high = 12;
    floor = 3;
    ceil = 15;
  } else {
    low = 4;
    high = 9;
    floor = 3;
    ceil = 12;
  }

  return { expected, low, high, floor, ceil };
}
function getZone(v, band) {
  if(v < band.low)return'low';
  if(v <= band.high)return'optimal';
  return'high';
}
function valToGaugePct(v, band) {
  const c=Math.min(Math.max(v,band.floor),band.ceil);
  if(c<=band.low)return((c-band.floor)/Math.max(band.low-band.floor,0.01))*40;
  if(c<=band.high)return 40+((c-band.low)/Math.max(band.high-band.low,0.01))*33;
  return 73+((c-band.high)/Math.max(band.ceil-band.high,0.01))*27;
}
function getBaseMult() {
  const s=[-0.10,0,0.06][+document.getElementById('sleep').value+1];
  const d=[0,0.08,0.16,0.28][+document.getElementById('sleepdebt').value];
  const w=[0,0.06,0.15,0.26][+document.getElementById('weekstress').value];
  return 1+s+d+w;
}
function getCircadianBase() {
  const mult=getBaseMult();
  const wakeHour=+document.getElementById('wakehour').value;
  const wakeFeeling=+document.getElementById('wakefeeling').value;
  const shift=wakeHour-6;
  const shifted=BASE_CURVE.map((_,h)=>+(BASE_CURVE[(h-shift+24)%24]*mult).toFixed(1));

  // Cortisol awakening response: peak roughly 30–60 min after waking.
  const carPeak= Math.min(23, wakeHour + 1);
  const carProfile = [
    { hour: wakeHour, add: 1 + wakeFeeling * 1.5 },
    { hour: carPeak, add: 4 + wakeFeeling * 4 },
    { hour: Math.min(23, wakeHour + 2), add: 2 + wakeFeeling * 2 },
    { hour: Math.min(23, wakeHour + 3), add: wakeFeeling > 0 ? 1 : 0 },
  ];

  carProfile.forEach(({ hour, add }) => {
    shifted[hour] = +(shifted[hour] + add).toFixed(1);
  });

  return shifted;
}
function computeCurve() {
  const base=getCircadianBase();
  const delta=new Array(24).fill(0);
  events.forEach(ev=>{
    const def=EVENT_TYPES.find(t=>t.value===ev.typeValue);
    if(!def)return;
    const peakH=ev.hour+def.rise;
    for(let h=0;h<24;h++){
      if(h<ev.hour)continue;
      let c=h<=peakH?def.delta*((h-ev.hour)/Math.max(def.rise,0.01)):def.delta*Math.exp(-(h-peakH)*Math.LN2/def.decay);
      delta[h]+=c;
    }
  });
  return base.map((b,i)=>Math.max(4,+(b+delta[i]).toFixed(1)));
}

const labels24=Array.from({length:24},(_,i)=>`${String(i).padStart(2,'0')}:00`);

let mainChart;
function buildMainChart(curve) {
  mainChart=new Chart(document.getElementById('mainChart'),{
    type:'line',
    data:{labels:labels24,datasets:[
      {label:'Kortizol',data:curve,borderColor:'#5C7A5E',backgroundColor:'rgba(92,122,94,0.12)',borderWidth:2.5,fill:true,tension:0.4,pointRadius:0,pointHoverRadius:4,order:2},
      {label:'Homeostáza horní',data:Array(24).fill(22),borderColor:'rgba(42,125,79,0)',borderWidth:0,pointRadius:0,fill:'+1',backgroundColor:'rgba(42,125,79,0.12)',order:4},
      {label:'Homeostáza dolní',data:Array(24).fill(10),borderColor:'rgba(42,125,79,0.4)',borderWidth:1,borderDash:[3,3],pointRadius:0,fill:false,order:5},
      {label:'Nadměrná zóna',data:Array(24).fill(40),borderColor:'rgba(196,96,58,0.5)',borderWidth:1.5,borderDash:[4,3],pointRadius:0,fill:false,order:3},
      {label:'Spánkový ideál',data:Array(24).fill(null).map((_,i)=>i>=20?8:null),borderColor:'rgba(42,125,79,0.7)',borderWidth:1.5,borderDash:[2,2],pointRadius:0,fill:false,order:6},
      {label:'Teď',data:Array(24).fill(null),borderColor:'rgba(196,96,58,0.7)',borderWidth:2,borderDash:[5,4],pointRadius:0,fill:false,order:1},
      {label:'Eventy',data:Array(24).fill(null),borderColor:'transparent',backgroundColor:'transparent',pointRadius:Array(24).fill(0),fill:false,order:0}
    ]},
    options:{
      responsive:true,maintainAspectRatio:false,animation:{duration:350},
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>{
        if(c.datasetIndex===0)return`${c.parsed.y.toFixed(1)} nmol/L`;
        if(c.datasetIndex===4)return'Ideál před spaním: 7–9 nmol/L';
        return null;
      }}}},
      scales:{
        x:{ticks:{maxTicksLimit:8,color:'#71717a',font:{size:10},autoSkip:true},grid:{color:'rgba(255,255,255,0.04)'}},
        y:{min:0,max:65,ticks:{color:'#71717a',font:{size:10},callback:v=>v+' nmol/L'},grid:{color:'rgba(255,255,255,0.04)'}}
      }
    }
  });
}

function updateNowLine(h){const d=Array(24).fill(null);d[h]=65;mainChart.data.datasets[5].data=d;}
function updateEventDots(curve){
  const r=Array(24).fill(0),bg=Array(24).fill('transparent'),bc=Array(24).fill('transparent');
  events.forEach(ev=>{const def=EVENT_TYPES.find(t=>t.value===ev.typeValue);if(!def)return;r[ev.hour]=Math.max(r[ev.hour],7);bg[ev.hour]=TYPE_COLOR[def.type];bc[ev.hour]='white';});
  const dotData=Array(24).fill(null).map((_,i)=>r[i]>0?curve[i]:null);
  const ds=mainChart.data.datasets[6];
  ds.data=dotData;ds.pointRadius=r;ds.pointBackgroundColor=bg;ds.pointBorderColor=bc;ds.pointBorderWidth=Array(24).fill(2);ds.pointHoverRadius=r.map(x=>x+2);
}

function updateSleepIndicator(curve){
  const val=curve[22];
  const el=document.getElementById('sleep-val'),bar=document.getElementById('sleep-bar'),msg=document.getElementById('sleep-msg');
  let color,msgText;
  if(val<=10){color='#5C7A5E';msgText='✓ Výborně — hladina kortizolu je ideální pro nástup hlubokého spánku a noční regeneraci.';}
  else if(val<=14){color='#B8962E';msgText=`↑ Mírně zvýšená (${val.toFixed(1)} nmol/L). Doporučujeme dechovou práci nebo 20minutový odpočinek bez obrazovek před ulehnutím.`;}
  else if(val<=22){color='#C4603A';msgText=`⚠ Zvýšená (${val.toFixed(1)} nmol/L) — nástup spánku bude obtížnější. Vyzkoušejte kryokomoru odpoledne nebo dechovou práci večer.`;}
  else{color='#ef4444';msgText=`⚠ Výrazně zvýšená (${val.toFixed(1)} nmol/L) — kortizol naruší architekturu spánku. Okamžitá intervence doporučena.`;}
  el.textContent=val.toFixed(1)+' nmol/L';el.style.color=color;
  bar.style.width=Math.min(100,(val/30)*100)+'%';bar.style.background=color;
  msg.textContent=msgText;
}

function updateAll(){
  const curve=computeCurve();lastCurve=curve;
  const baseCurve=getCircadianBase();
  mainChart.data.datasets[0].data=curve;
  updateNowLine(currentHour);updateEventDots(curve);mainChart.update();
  const val=curve[currentHour],band=getExpectedBand(baseCurve,currentHour),zone=getZone(val,band),col=ZONE_COLORS[zone],lbl=ZONE_LABELS[zone];
  document.getElementById('m-now').innerHTML=`${val.toFixed(1)} <span style="font-size:9px;padding:1px 6px;background:${col}25;color:${col};font-family:sans-serif;letter-spacing:0.06em;text-transform:uppercase;">${lbl}</span>`;
  document.getElementById('m-peak').textContent=Math.max(...curve).toFixed(1);
  document.getElementById('m-min').textContent=Math.min(...curve).toFixed(1);
  document.getElementById('m-phase').textContent=PHASES[currentHour];
  document.getElementById('phase-tip').textContent=`${TIPS[getTipIdx(currentHour)]} Očekávané pásmo pro tuto hodinu je přibližně ${band.low.toFixed(1)}–${band.high.toFixed(1)} nmol/L.`;
  document.getElementById('gauge-marker').style.left=valToGaugePct(val,band)+'%';
  updateSleepIndicator(curve);
  const panel=document.getElementById('intervention-panel');
  if(zone!=='high'){panel.style.display='none';return;}
  panel.style.display='block';
  const items=INTERVENTIONS.high;
  const hdr=document.getElementById('intv-header'),icon=document.getElementById('intv-icon'),title=document.getElementById('intv-title'),sub=document.getElementById('intv-sub'),tags=document.getElementById('intv-tags');
  hdr.style.background='rgba(196,96,58,0.1)';icon.style.background='#C4603A';title.style.color='#C4603A';title.textContent='Nadměrná hladina — okamžitá intervence';sub.textContent='Hladina překračuje zdravé maximum — doporučujeme intervenci ihned';
  tags.innerHTML=items.map(i=>`<span class="k-intv-tag"><span class="k-tag-dot" style="background:${i.dot}"></span>${i.label}</span>`).join('');
}

window.addEventFromUI=function(){
  const typeValue=document.getElementById('event-type-select').value;
  const hour=Math.min(23,Math.max(0,+document.getElementById('event-hour-input').value));
  events.push({id:++eventIdCounter,hour,typeValue});renderActiveEvents();updateAll();
};
window.removeEvent=function(id){events=events.filter(e=>e.id!==id);renderActiveEvents();updateAll();};
window.updateEventHour=function(id,val){const ev=events.find(e=>e.id===id);if(ev){ev.hour=Math.min(23,Math.max(0,+val));updateAll();}};

function renderActiveEvents(){
  const list=document.getElementById('events-list');
  if(events.length===0){list.innerHTML='<p class="text-[11px] text-zinc-400 leading-relaxed py-2">Klikněte na událost výše pro přidání do denního profilu.</p>';return;}
  list.innerHTML=events.map(ev=>{
    const def=EVENT_TYPES.find(t=>t.value===ev.typeValue);
    const col=def?TYPE_COLOR[def.type]:'#888';
    const sign=def&&def.delta>0?'+':'';
    return`<div class="k-event-row">
      <div class="k-event-bar" style="background:${col};"></div>
      <input type="number" min="0" max="23" value="${ev.hour}" class="k-event-hour" title="Hodina události" onchange="updateEventHour(${ev.id},this.value)" style="border-color:${col}60;color:#f4f4f5;-webkit-text-fill-color:#f4f4f5;">
      <span class="k-event-label"><span style="color:#f4f4f5;-webkit-text-fill-color:#f4f4f5;">${def?def.icon+' '+def.label:'—'}</span> <span style="color:${col};font-size:10px;">${sign}${def?def.delta:0}</span></span>
      <button class="k-event-del" onclick="removeEvent(${ev.id})">×</button>
    </div>`;
  }).join('');
}

['sleep','sleepdebt','weekstress','wakehour','wakefeeling'].forEach(id=>document.getElementById(id).addEventListener('change',updateAll));
document.getElementById('hour-slider').addEventListener('input',function(){
  currentHour=+this.value;document.getElementById('hour-out').textContent=String(currentHour).padStart(2,'0')+':00';updateAll();
});

document.getElementById('lead-form').addEventListener('submit',function(){
  document.getElementById('f-sleep').value=document.getElementById('sleep').value;
  document.getElementById('f-sleepdebt').value=document.getElementById('sleepdebt').value;
  document.getElementById('f-weekstress').value=document.getElementById('weekstress').value;
  document.getElementById('f-wakehour').value=document.getElementById('wakehour').value;
  document.getElementById('f-wakefeeling').value=document.getElementById('wakefeeling').value;
  document.getElementById('f-events').value=JSON.stringify(events.map(e=>({type:e.typeValue,hour:e.hour})));
  document.getElementById('f-cortizol-now').value=lastCurve[currentHour];
  document.getElementById('f-cortizol-sleep').value=lastCurve[22];
});

buildMainChart(computeCurve());
updateNowLine(currentHour);
renderActiveEvents();
updateAll();
</script>

<script>
  const observer = new IntersectionObserver(
    (entries) => { entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); }); },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) { el.classList.add('visible'); } else { observer.observe(el); }
  });
</script>
