---
import Layout from '../../../../layouts/Layout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import StudioModal from '../../../../components/StudioModal.astro';
---

<Layout
  title="Kortizolový rytmus — Adaptive Studio"
  description="Zjistěte svůj odhadovaný kortizolový profil. Interaktivní nástroj pro pochopení vlivu stresu, spánku a denních událostí na hladinu kortizolu."
  lang="cs"
>
  <StudioModal lang="cs" />
  <Nav lang="cs" />

  <main>

    <!-- HERO -->
    <section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-10">APLIKACE · KORTIZOL</p>
      <h1 class="font-heading font-bold leading-[0.9] tracking-tight text-zinc-900 mb-10 reveal"
          style="font-size: clamp(3rem, 9vw, 8rem)">
        Váš kortizol<br>pracuje za vás?
      </h1>
      <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-xl reveal reveal-delay-1">
        Nebo vy pracujete pro něj.
      </p>
      <p class="text-sm text-zinc-400 leading-relaxed max-w-lg mt-4 reveal reveal-delay-2">
        Kortizol řídí váš výkon, regeneraci i spánek. Zjistěte, kde se na křivce nacházíte — a co s tím dělat.
      </p>
      <div class="mt-12 flex flex-wrap gap-4 reveal reveal-delay-3">
        <a href="#nastroj"
           class="inline-flex items-center justify-center px-10 py-4 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200">
          Zjistit svůj rytmus
        </a>
        <a href="#co-je-kortizol"
           class="inline-flex items-center justify-center px-10 py-4 border border-zinc-300 text-zinc-700 text-xs font-semibold tracking-[0.2em] uppercase hover:border-zinc-900 transition-colors duration-200">
          Proč na tom záleží
        </a>
      </div>
    </section>

    <!-- CO JE KORTIZOL — světlá -->
    <section id="co-je-kortizol" class="border-t border-zinc-100 px-6 sm:px-10 lg:px-20 py-24">
      <div class="mb-16 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">CO JE KORTIZOL</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
          Hormon, který řídí vše.
        </h2>
        <a
          href="/preview/aplikace/kortizol/10-pravidel/"
          class="group mt-8 block max-w-xl border border-zinc-200 bg-zinc-50/70 p-6 hover:border-zinc-300 hover:bg-zinc-50 transition-colors duration-200"
        >
          <p class="text-[10px] tracking-[0.22em] uppercase text-sage mb-3">Doporučené čtení</p>
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="font-heading text-2xl font-bold tracking-tight text-zinc-900 mb-3">
                10 pravidel kortizolu
              </p>
              <p class="text-zinc-500 text-sm leading-relaxed">
                Krátký rámec pro to, jak číst kortizol v kontextu stresu, výkonu, spánku a regenerace.
              </p>
            </div>
            <span aria-hidden="true" class="text-zinc-400 group-hover:text-zinc-900 transition-colors duration-200 mt-1">→</span>
          </div>
        </a>
      </div>
      <div class="grid md:grid-cols-3 md:divide-x divide-zinc-200 gap-16 md:gap-0">
        <div class="flex flex-col md:pr-12 reveal reveal-delay-1">
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">24</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Hodinový cyklus</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">Každá hodina má svou funkci</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Kortizol sleduje přesný cirkadiánní rytmus. Ráno vás probouzí, odpoledne klesá, večer se vypíná. Problém nastává, když ho vyčerpáte nebo zdeformujete chronickým stresem.
          </p>
        </div>
        <div class="flex flex-col md:px-12 reveal reveal-delay-2">
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">3×</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Chronický stres</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">Vyšší hladiny ničí zdraví</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Dlouhodobě zvýšený kortizol poškozuje imunitu, paměť i srdeční zdraví. Zkracuje telomery a urychluje biologické stárnutí. Nejde o únavu — jde o systémové poškození.
          </p>
        </div>
        <div class="flex flex-col md:pl-12 reveal reveal-delay-3">
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">48h</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Regenerace osy</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">Obnova trvá dny, ne hodiny</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Po intenzivním stresu se kortizolová osa plně neobnoví za pár hodin spánku. Správná regenerace je načasovaný proces — a přesně to trénujeme.
          </p>
        </div>
      </div>
    </section>

    <!-- INTERAKTIVNÍ NÁSTROJ — tmavá -->
    <section id="nastroj" class="bg-[#111110] px-6 sm:px-10 lg:px-20 py-24">
      <div class="mb-12 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">INTERAKTIVNÍ NÁSTROJ</p>
        <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight text-white">
          Sestavte svůj dnešní den.
        </h2>
        <p class="text-zinc-400 text-sm mt-4 max-w-lg">
          Přidejte události, ke kterým dnes došlo. Křivka se dynamicky přizpůsobí — s biologicky realistickým nástupem a pomalým poklesem.
        </p>
      </div>

      <div class="grid lg:grid-cols-[300px_1fr] gap-6 items-start">

        <!-- LEFT: controls -->
        <div class="flex flex-col gap-4">

          <!-- Baseline -->
          <div class="border border-zinc-700 bg-zinc-900 p-5">
            <p class="text-[9px] tracking-[0.2em] uppercase text-zinc-300 font-semibold mb-4 pb-3 border-b border-zinc-700">Výchozí stav</p>
            <div class="space-y-4">
              <div>
                <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">Kvalita spánku minulá noc</label>
                <select class="k-select" id="sleep">
                  <option value="-1">Špatná — méně než 5 h</option>
                  <option value="0" selected>Průměrná — 6–7 h</option>
                  <option value="1">Dobrá — 7–9 h</option>
                </select>
              </div>
              <div>
                <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">Spánkový dluh (počet nocí)</label>
                <select class="k-select" id="sleepdebt">
                  <option value="0" selected>Žádný</option>
                  <option value="1">1–2 noci</option>
                  <option value="2">3–5 nocí</option>
                  <option value="3">Chronická insomnie</option>
                </select>
              </div>
              <div>
                <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">Stresová zátěž týdne</label>
                <select class="k-select" id="weekstress">
                  <option value="0">Klidný týden</option>
                  <option value="1" selected>Běžný pracovní týden</option>
                  <option value="2">Náročný týden</option>
                  <option value="3">Extrémní zátěž</option>
                </select>
              </div>
              <div>
                <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">Kdy jste se vzbudili</label>
                <select class="k-select" id="wakehour">
                  <option value="4">04:00–04:59</option>
                  <option value="5">05:00–05:59</option>
                  <option value="6" selected>06:00–06:59</option>
                  <option value="7">07:00–07:59</option>
                  <option value="8">08:00–08:59</option>
                  <option value="9">09:00–09:59</option>
                  <option value="10">10:00–10:59</option>
                  <option value="11">11:00–11:59</option>
                </select>
              </div>
              <div>
                <label class="text-[9px] tracking-[0.12em] uppercase text-zinc-500 block mb-2">Jak jste se cítili po probuzení</label>
                <select class="k-select" id="wakefeeling">
                  <option value="-1">Vyčerpaně / bez energie</option>
                  <option value="0" selected>Normálně / neutrálně</option>
                  <option value="1">Svěže / plní energie</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Events -->
          <div class="border border-zinc-700 bg-zinc-900 p-5">
            <p class="text-[9px] tracking-[0.2em] uppercase text-zinc-300 font-semibold mb-4 pb-3 border-b border-zinc-700">Události dne</p>
            <div class="grid grid-cols-[1fr_64px_36px] gap-1.5 mb-3">
              <select class="k-select text-[11px]" id="event-type-select">
                <optgroup label="⚡ Stresory">
                  <option value="conflict">⚡ Hádka / konflikt</option>
                  <option value="deadline">📌 Deadline / prezentace</option>
                  <option value="badnews">📰 Špatná zpráva</option>
                  <option value="publicsp">🎤 Veřejné vystoupení</option>
                  <option value="hiit">🏋 Intenzivní trénink</option>
                  <option value="traffic">🚗 Stres v dopravě</option>
                  <option value="coldshower">🚿 Studená sprcha</option>
                  <option value="overload">📋 Přetížení / multitasking</option>
                </optgroup>
                <optgroup label="🌿 Uklidnění">
                  <option value="cryo">❄ Kryokomora</option>
                  <option value="redlight">🔴 Červené světlo</option>
                  <option value="breathwork">💬 Dechová práce</option>
                  <option value="yoga">🧘 Jóga / meditace</option>
                  <option value="walk">🚶 Procházka v přírodě</option>
                  <option value="nap">😴 Krátký spánek (20 min)</option>
                  <option value="social">🤝 Příjemné setkání</option>
                </optgroup>
                <optgroup label="○ Ostatní">
                  <option value="caffeine_am">☕ Káva ráno (do 11:00)</option>
                  <option value="caffeine_pm">☕ Káva po 14:00</option>
                  <option value="alcohol">🍷 Alkohol (večer)</option>
                  <option value="skippedmeal">🍽 Vynechané jídlo</option>
                  <option value="screen">📱 Obrazovky před spaním</option>
                </optgroup>
              </select>
              <input type="number" class="k-select k-hour-input text-center text-[11px]" id="event-hour-input" min="0" max="23" value="9" title="Hodina (0–23)">
              <button onclick="addEventFromUI()"
                class="bg-white text-zinc-900 text-lg font-bold hover:bg-sage hover:text-white transition-colors duration-150 flex items-center justify-center">+</button>
            </div>
            <p class="text-[10px] text-zinc-400 mb-3">Vyberte událost, zadejte hodinu, stiskněte +</p>
            <div id="events-list">
              <p class="text-[11px] text-zinc-600 leading-relaxed py-2">Zatím žádné události. Přidejte co se vám dnes stalo.</p>
            </div>
          </div>
        </div>

        <!-- RIGHT: chart area -->
        <div class="border border-zinc-800 p-6">

          <!-- Metrics -->
          <div class="grid grid-cols-4 gap-px bg-zinc-800 border border-zinc-800 mb-5">
            <div class="bg-[#111110] px-3 py-3">
              <div class="font-heading text-lg font-bold text-white mb-1" id="m-now">—</div>
              <div class="text-[10px] text-zinc-500">Aktuální (nmol/L)</div>
            </div>
            <div class="bg-[#111110] px-3 py-3">
              <div class="font-heading text-lg font-bold text-white mb-1" id="m-peak">—</div>
              <div class="text-[10px] text-zinc-500">Denní maximum</div>
            </div>
            <div class="bg-[#111110] px-3 py-3">
              <div class="font-heading text-lg font-bold text-white mb-1" id="m-min">—</div>
              <div class="text-[10px] text-zinc-500">Noční minimum</div>
            </div>
            <div class="bg-[#111110] px-3 py-3">
              <div class="font-heading text-[11px] font-bold text-white mb-1 leading-tight" id="m-phase">—</div>
              <div class="text-[10px] text-zinc-500">Fáze dne</div>
            </div>
          </div>

          <!-- Gauge -->
          <div class="mb-5">
            <p class="text-[9px] tracking-[0.15em] uppercase text-zinc-500 mb-3">Míra kortizolu — aktuální hodina</p>
            <div class="relative h-2.5 rounded-full overflow-visible mb-2"
                 style="background: linear-gradient(to right, #2a7d4f 0%, #2a7d4f 40%, #185FA5 40%, #185FA5 73%, #C4603A 73%, #C4603A 100%);">

              <div id="gauge-marker" class="absolute top-[-4px] w-[18px] h-[18px] rounded-full bg-white border-[2.5px] border-zinc-900 -translate-x-1/2 shadow-md z-10 transition-all duration-500" style="left:35%;"></div>
            </div>
            <div class="flex justify-between text-[9px] uppercase tracking-wide mt-2">
              <span id="gauge-low-label" style="color:#2a7d4f;" class="font-semibold">Nízká</span>
              <span id="gauge-mid-label" style="color:#185FA5;">V normě</span>
              <span id="gauge-high-label" style="color:#C4603A;" class="font-semibold">⚠ Vysoká</span>
            </div>
          </div>

          <!-- Chart -->
          <div class="relative h-[200px] mb-3">
            <canvas id="mainChart" role="img" aria-label="Dynamický kortizolový profil dne"></canvas>
          </div>

          <!-- Time slider -->
          <div class="flex items-center gap-3 pt-3 border-t border-zinc-800">
            <span class="text-[11px] text-zinc-500 whitespace-nowrap">čas:</span>
            <input type="range" min="0" max="23" value="8" id="hour-slider" step="1" class="k-slider flex-1">
            <span class="text-sm font-semibold text-white min-w-[40px]" id="hour-out">08:00</span>
          </div>

          <!-- Phase tip -->
          <div id="phase-tip" class="mt-3 p-3 bg-zinc-900 border-l-2 border-sage text-[12px] text-zinc-400 leading-relaxed"></div>

          <!-- Sleep indicator -->
          <div class="mt-4 border border-zinc-800">
            <div class="flex items-center gap-3 px-4 py-3 bg-zinc-900 border-b border-zinc-800">
              <span class="text-base">🌙</span>
              <div>
                <div class="text-[11px] font-semibold text-white">Kortizol před spaním (22:00)</div>
                <div class="text-[10px] text-zinc-500">Ideál pro hluboký spánek: 7–9 nmol/L</div>
              </div>
            </div>
            <div class="px-4 py-3">
              <div class="flex justify-between items-end mb-2">
                <div>
                  <div class="text-[9px] uppercase tracking-widest text-zinc-600 mb-1">Vaše odhadovaná hladina</div>
                  <div id="sleep-val" class="font-heading text-2xl font-bold" style="color:#C4603A;">—</div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-semibold" style="color:#2a7d4f;">7–9 nmol/L</div>
                  <div class="text-[9px] uppercase tracking-widest text-zinc-600">Ideál pro spánek</div>
                </div>
              </div>
              <div class="relative h-1.5 bg-zinc-800 rounded-full mb-2 overflow-visible">
                <div id="sleep-bar" class="h-full rounded-full transition-all duration-500" style="width:0%;background:#C4603A;"></div>
                <div class="absolute top-[-3px] w-[2px] h-[12px] rounded-sm" style="left:16%;background:#2a7d4f;"></div>
              </div>
              <div id="sleep-msg" class="text-[11px] text-zinc-500 leading-relaxed pt-2 border-t border-zinc-800">—</div>
            </div>
          </div>

          <!-- Intervention panel -->
          <div id="intervention-panel" class="mt-4 border border-zinc-700" style="display:none;">
            <div id="intv-header" class="flex items-center gap-3 px-4 py-3">
              <div id="intv-icon" class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] text-white font-bold flex-shrink-0" style="background:#C4603A;">!</div>
              <div>
                <strong id="intv-title" class="block text-[12px] font-semibold"></strong>
                <span id="intv-sub" class="text-[11px] text-zinc-500"></span>
              </div>
            </div>
            <div id="intv-tags" class="px-4 pb-3 flex flex-wrap gap-2"></div>
          </div>

        </div>
      </div>

      <p class="text-[10px] text-zinc-600 mt-6 leading-relaxed">⚠ Edukativní model, nikoliv lékařský test. Hodnoty jsou orientační a vychází z cirkadiánní fyziologie. Pro diagnostiku HPA osy je nutný klinický test.</p>
    </section>

    <!-- INTERVENCE — světlá -->
    <section id="sluzby" class="px-6 sm:px-10 lg:px-20 py-24">
      <div class="mb-16 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">INTERVENCE V ADAPTIVE STUDIU</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
          Každá metoda cílí<br>na konkrétní zónu.
        </h2>
        <p class="text-zinc-400 text-sm mt-4 max-w-lg">Kryokomora, červené světlo, dechová práce a nervový trénink — každá intervence má přesný mechanismus účinku na kortizolovou osu.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-0 md:divide-x divide-zinc-200">
        <div class="flex flex-col lg:pr-8 reveal reveal-delay-1">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Kortizol ↓↓ po zátěži</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Kryokomora</p>
          <p class="text-zinc-500 text-sm leading-relaxed mb-4">
            Krátkodobý extrémní chlad (−110 °C) spouští adaptivní stresovou odpověď a následně hluboký parasympatický útlum. Kortizol klesá, endorfiny stoupají.
          </p>
          <p class="text-[10px] text-zinc-400 mt-auto"><strong class="text-zinc-700">Optimální čas:</strong> odpoledne 14–18 h nebo po intenzivní zátěži.</p>
        </div>
        <div class="flex flex-col lg:px-8 reveal reveal-delay-2">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Kortizol ↓ rytmus &amp; osa</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Červené světlo</p>
          <p class="text-zinc-500 text-sm leading-relaxed mb-4">
            Red light therapy (630–850 nm) podporuje mitochondriální funkci a cirkadiánní synchronizaci. Přirozeně nastavuje denní kortizolový vzorec.
          </p>
          <p class="text-[10px] text-zinc-400 mt-auto"><strong class="text-zinc-700">Optimální čas:</strong> ráno 6–9 h pro synchronizaci, večer pro zklidnění osy.</p>
        </div>
        <div class="flex flex-col lg:px-8 reveal reveal-delay-3">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">HRV ↑ &amp; parasympatikus</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Dechová práce</p>
          <p class="text-zinc-500 text-sm leading-relaxed mb-4">
            Vědomé dechové techniky aktivují parasympatický nervový systém a snižují cirkulující kortizol. Dovednost, kterou si odnesete a použijete kdykoli.
          </p>
          <p class="text-[10px] text-zinc-400 mt-auto"><strong class="text-zinc-700">Optimální čas:</strong> kdykoli — zvláště při nadměrné hladině. Efekt do 10 minut.</p>
        </div>
        <div class="flex flex-col lg:pl-8 reveal reveal-delay-4">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Adaptabilita &amp; odolnost</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Nervový trénink</p>
          <p class="text-zinc-500 text-sm leading-relaxed mb-4">
            1:1 program zaměřený na vědomou regulaci autonomního nervového systému. Trénujeme schopnost přecházet mezi aktivací a regenerací — dlouhodobě.
          </p>
          <p class="text-[10px] text-zinc-400 mt-auto"><strong class="text-zinc-700">Výsledky:</strong> viditelné do 4 týdnů.</p>
        </div>
      </div>
    </section>

    <!-- CITÁT — tmavá -->
    <section class="bg-[#111110] px-6 sm:px-10 lg:px-20 py-24">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="reveal">
          <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">VĚDA ZA METODOU</p>
          <blockquote class="border-l-2 border-sage pl-8">
            <p class="font-heading text-2xl sm:text-3xl font-bold text-white leading-tight mb-6">
              "Kortizol není nepřítel. Je to nejpřesnější biologický časovač, který máte. Problém nastává, když ho ignorujete."
            </p>
            <cite class="text-[10px] tracking-[0.2em] uppercase text-zinc-500 not-italic">Adaptivní fyziologie — základ přístupu studia</cite>
          </blockquote>
        </div>
        <div class="reveal reveal-delay-1 space-y-6">
          {[
            { title: 'CAR reakce — nejdůležitější okamžik dne', body: '30–45 minut po probuzení kortizol přirozeně vrcholí. To, jak ho využijete, určuje výkon na celý den.' },
