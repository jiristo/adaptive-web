---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import StudioModal from '../../../components/StudioModal.astro';

const MAX_PARTICIPANTS = 8;
const participantIndexes = Array.from({ length: MAX_PARTICIPANTS }, (_, i) => i + 1);

const schedule = [
  {
    day: 'PÁTEK',
    title: 'Rewind',
    items: [
      { time: '16:00–18:00', name: 'Příjezd', desc: 'Ubytování bez spěchu.' },
      { time: '18:30', name: 'Večeře', desc: 'Pořádné jídlo u jednoho stolu.' },
      { time: '20:00', name: 'TV OFF', desc: 'Telefony do krabice. Víkend začíná.' },
      { time: '20:30', name: 'Literární večer', desc: 'Čtení, kazety a první smích.' },
    ],
  },
  {
    day: 'SOBOTA',
    title: 'No Signal',
    items: [
      { time: '09:30', name: 'Snídaně', desc: 'Start až po spánku. Žádný ranní sprint.' },
      { time: '10:30', name: 'Cryo Reset', desc: 'Ledový restart těla.' },
      { time: '11:30', name: 'Walkman Walk', desc: 'Les, sluchátka a kazeta.' },
      { time: '13:00', name: 'Offline Time', desc: 'Volno bez programu a bez výčitek.' },
      { time: '16:00', name: 'Reset', desc: 'Prostor jen tak být.' },
      { time: '17:30', name: 'Sauna Club 1999', desc: 'Horko, historky a smích.' },
      { time: '20:30', name: 'Life Before WiFi', desc: 'Karty, deskovky a kecy do noci.' },
    ],
  },
  {
    day: 'NEDĚLE',
    title: 'Slow Sunday',
    items: [
      { time: '09:30', name: 'Snídaně', desc: 'Pomalu. Jak jinak v neděli.' },
      { time: '10:30', name: 'Ranní pohyb', desc: 'Protáhnout tělo po včerejší sauně.' },
      { time: '12:00', name: 'Offline Workshop', desc: 'Jak si kousek víkendu vzít domů.' },
      { time: '13:30', name: 'Odjezd', desc: 'Bez spěchu. S hlavou trochu jinde.' },
    ],
  },
] as const;
---

<Layout
  title="OFFLINE 1999 — digitální detox v Kapka Resortu | Meditace v šusťákovce"
  description="Víkend pro lidi, kteří už jsou unavení z toho být pořád online. 3 dny, 0 notifikací — wellness, kryo, příroda a dobré jídlo v Kapka Resortu, 6.–8. listopadu 2026. Early bird 6 990 Kč do 10. října."
  lang="cs"
>
  <StudioModal lang="cs" />
  <Nav lang="cs" />

  <main>

    <!-- Hero -->
    <section class="flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24 pt-36">
      <div class="max-w-4xl reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">OFFLINE 1999 · KAPKA RESORT · 6.–8. LISTOPADU 2026</p>
        <h1 class="font-heading font-bold leading-[0.95] tracking-tight text-zinc-900 mb-6"
            style="font-size: clamp(2.5rem, 7vw, 5rem)">
          Víkend pro lidi, kteří už jsou unavení z toho být pořád online.
        </h1>
        <p class="font-heading text-xl sm:text-2xl font-semibold text-sage mb-8">
          Digitální detox, který nevypadá jako retreat.
        </p>
        <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-2xl mb-4">
          3 dny. 0 notifikací. Wellness, kryo, příroda, dobré jídlo a návrat do doby, kdy jsme nemuseli být pořád k dispozici.
        </p>
        <p class="text-zinc-400 text-sm tracking-[0.02em] mb-10">
          A až potom: kazety, hákis, walkman, šusťákovky, devadesátky.
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <a href="#signup"
             class="inline-flex items-center justify-center px-10 py-4 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200">
            Chci zažít OFFLINE 1999
          </a>
          <p class="text-zinc-400 text-xs tracking-[0.1em] uppercase">Early bird 6 990 Kč <span id="earlybird-countdown">do 10. října</span> · pak 7 490 Kč</p>
        </div>
      </div>

      <div class="reveal reveal-delay-1 mt-16">
        <div class="grid sm:grid-cols-2 gap-3 md:gap-4 max-w-5xl">
          <div class="relative aspect-[4/3] overflow-hidden bg-zinc-100">
            <img src="/images/90s-retreat-billboard.webp" alt="Billboard OFFLINE 1999 a cedule Meditace v Šusťákovce před Kapka Resortem" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="relative aspect-[4/3] overflow-hidden bg-zinc-100">
            <img src="/images/90s-retreat-famillyfrost.webp" alt="Retro párty u zmrzlinářského auta s cedulí Dopaminový detox" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Quick facts -->
      <div class="reveal reveal-delay-2 mt-12 bg-zinc-900 text-white px-6 sm:px-8 py-6 max-w-3xl">
        <p class="font-heading text-base sm:text-lg font-semibold tracking-tight mb-2">
          6.–8. listopadu · Kapka Resort · 2 noci · od 6 990 Kč
        </p>
        <p class="text-zinc-300 text-sm leading-relaxed">
          Ubytování + snídaně + wellness + kryo + kompletní program.
        </p>
      </div>
    </section>

    <!-- Pro koho -->
    <section class="border-t border-zinc-100 bg-zinc-50/70">
      <div class="px-6 sm:px-10 lg:px-20 py-24">
        <div class="max-w-3xl reveal">
          <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">PRO KOHO TO JE</p>
          <p class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-zinc-900 leading-snug">
            Pamatuješ si víkend, kdy ti nikdo nenapsal?
          </p>
          <p class="mt-6 text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-2xl">
            Jsi pořád online, hlava přehlcená, pořád něco řešíš — a víkend, kdy po tobě nikdo nic nechtěl, je už strašně dávno. Přesně proto je OFFLINE 1999.
          </p>
        </div>

        <div class="mt-16 grid md:grid-cols-2 gap-10 items-center reveal reveal-delay-1">
          <div class="relative aspect-[4/3] overflow-hidden bg-zinc-100 order-2 md:order-1">
            <img src="/images/90s-retreat-meditace.webp" alt="Skupina v teplákových soupravách při meditaci u kazeťáku" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="space-y-10 order-1 md:order-2">
            <p class="font-heading text-xl sm:text-2xl md:text-3xl font-semibold text-zinc-900 leading-snug border-l-2 border-sage pl-6">
              Proto jsme reset zabalili do devadesátek — kazety, hákis, walkman, sauna. Ne jako vtip, ale jako způsob, jak se na tři dny fakt odpojit.
            </p>
            <p class="font-heading text-xl sm:text-2xl md:text-3xl font-semibold text-zinc-900 leading-snug border-l-2 border-sage pl-6">
              Meditace v šusťákovce. Žádné předstírání, že tě nabíjí hodinu čučet na šišku a hudrat óhm.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Není / Je -->
    <section class="px-6 sm:px-10 lg:px-20 py-24 border-t border-zinc-100">
      <div class="grid md:grid-cols-4 gap-10 lg:gap-10">
        <div class="relative aspect-[3/4] overflow-hidden bg-zinc-100 reveal order-3 md:order-1">
          <img src="/images/90s-retreat-terry.webp" alt="Retro portrét v duchu devadesátek" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="reveal order-1 md:order-2">
          <p class="text-[10px] tracking-[0.4em] uppercase text-zinc-400 mb-6">TOHLE NENÍ</p>
          <ul class="space-y-4">
            {[
              'Žádné obřady.',
              'Žádné krystaly v rektu.',
              'Žádný guru.',
            ].map((line) => (
              <li class="flex gap-3 text-zinc-500 text-base leading-relaxed">
                <span class="text-zinc-300 font-semibold" aria-hidden="true">✕</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-1 order-2 md:order-3">
          <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">TOHLE JO</p>
          <ul class="space-y-4">
            {['Sauna.', 'Pohyb.', 'Příroda.', 'Dobré jídlo.', 'Pár lidí, se kterýma se dá normálně kecat.'].map((line) => (
              <li class="flex gap-3 text-zinc-900 text-base font-medium leading-relaxed">
                <span class="text-sage font-semibold" aria-hidden="true">✓</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="relative aspect-[3/4] overflow-hidden bg-zinc-100 reveal reveal-delay-2 order-4">
          <img src="/images/90s-retreat-jiri.webp" alt="Retro portrét zakladatele Jiřího v duchu devadesátek" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Harmonogram -->
    <section class="border-t border-zinc-100 bg-zinc-50/70">
      <div class="px-6 sm:px-10 lg:px-20 py-24">
        <div class="mb-16 grid md:grid-cols-2 gap-10 items-end reveal">
          <div>
            <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">HARMONOGRAM</p>
            <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
              Tři dny mimo signál.
            </h2>
          </div>
          <div class="relative aspect-[16/9] overflow-hidden bg-zinc-100">
            <img src="/images/90s-retreat-sauna.webp" alt="Sauna Club 1999 — švihání metličkou v sauně" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>

        <div class="grid md:grid-cols-3 md:divide-x divide-zinc-200 gap-12 md:gap-0">
          {schedule.map((d, idx) => (
            <div class={`reveal reveal-delay-${idx + 1} ${idx === 0 ? 'md:pr-8' : idx === schedule.length - 1 ? 'md:pl-8' : 'md:px-8'}`}>
              <p class="text-[10px] tracking-[0.3em] uppercase text-zinc-400 mb-3">{d.day}</p>
              <h3 class="font-heading text-xl font-bold text-zinc-900 tracking-tight mb-5">{d.title}</h3>
              <ul class="space-y-5">
                {d.items.map((item) => (
                  <li>
                    <p class="text-xs font-semibold text-sage tracking-[0.12em] mb-1">{item.time}</p>
                    <p class="text-sm font-semibold text-zinc-900 tracking-tight mb-1">{item.name}</p>
                    <p class="text-zinc-500 text-sm leading-relaxed">{item.desc}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Stat bar -->
      <div class="bg-zinc-900 text-white px-6 sm:px-10 lg:px-20 py-8">
        <p class="text-center font-heading text-sm sm:text-base font-semibold tracking-[0.25em] uppercase text-white">
          3 DNY <span class="text-sage">·</span> 0 NOTIFIKACÍ <span class="text-sage">·</span> 100 % OFFLINE
        </p>
      </div>
    </section>

    <!-- Prakticky -->
    <section class="border-t border-zinc-100">
      <div class="px-6 sm:px-10 lg:px-20 py-24 reveal">
        <p class="text-[10px] tracking-[0.35em] uppercase text-zinc-400 mb-4">V retreatu je vše</p>
        <div class="flex flex-wrap gap-2">
          {['Cryo Reset', 'Walkman Walk', 'Sauna Club 1999', 'Hákis', 'Kazety', 'Offline Workshop'].map((item) => (
            <span class="px-4 py-2 border border-zinc-200 bg-white text-sm font-medium text-zinc-900">{item}</span>
          ))}
        </div>
      </div>

      <div class="bg-zinc-900 text-white px-6 sm:px-10 lg:px-20 py-8">
        <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
          <p class="text-[10px] tracking-[0.3em] uppercase text-sage shrink-0">Prakticky</p>
          <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-zinc-200">
            <span>6.–8. listopadu 2026</span>
            <span>Kapka Resort</span>
            <span>omezená kapacita</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Cena -->
    <section class="px-6 sm:px-10 lg:px-20 py-24 border-t border-zinc-100 bg-zinc-50/70">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 lg:gap-20 items-center reveal">
        <div class="relative aspect-[4/3] overflow-hidden bg-zinc-100 order-2 md:order-1">
          <img src="/images/90s-retreat-room.webp" alt="Dvoulůžkový pokoj v Kapka Resortu" class="w-full h-full object-cover" loading="lazy" />
        </div>

        <div class="order-1 md:order-2">
          <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-2">Early bird ticket</p>
          <p id="earlybird-urgency" class="text-xs font-semibold text-zinc-900 mb-6">do 10. října 2026</p>
          <p class="font-heading font-bold text-zinc-900 tracking-tight mb-2"
             style="font-size: clamp(3rem, 6vw, 4.5rem)">
            6 990 Kč
          </p>
          <p class="text-zinc-400 text-xs tracking-[0.15em] uppercase mb-10">za osobu · běžně 7 490 Kč · ušetříš 500 Kč</p>

          <div class="border-t border-zinc-200 pt-8">
            <p class="text-[10px] tracking-[0.3em] uppercase text-zinc-400 mb-5">Cena obsahuje</p>
            <ul class="space-y-3">
              {[
                '2 noci na dvoulůžkovém pokoji se snídaní',
                'Wellness se saunou',
                'Kryokomoru',
                '90s retreat program (meditace, literární večer, workshop, body work)',
              ].map((item) => (
                <li class="flex gap-3 text-zinc-700 text-sm sm:text-base leading-relaxed">
                  <span class="text-sage font-semibold" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Partneři -->
    <section class="px-6 sm:px-10 lg:px-20 py-24 border-t border-zinc-100">
      <div class="max-w-2xl mx-auto text-center reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">KDO ZA TÍM STOJÍ</p>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 mb-4">
          Tři parťáci, jeden retreat.
        </h2>
        <p class="text-zinc-500 text-sm leading-relaxed max-w-xl mx-auto">
          OFFLINE 1999 spolu dělají Adaptive Studio, Being Well Brno a Kapka Resort — tři zavedená jména, ne jen nápad na kampaň.
        </p>
      </div>

      <div class="mt-16 grid sm:grid-cols-3 gap-12 max-w-4xl mx-auto items-center reveal reveal-delay-1">
        <div class="flex flex-col items-center text-center gap-3">
          <p class="font-heading font-semibold text-xl tracking-[0.1em] uppercase text-zinc-900">Adaptive Studio</p>
          <p class="text-zinc-400 text-xs tracking-[0.1em] uppercase">Program a regenerace</p>
        </div>

        <a
          href="https://www.instagram.com/beingwellbrno/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center text-center gap-3 group"
        >
          <img src="/images/logo-being-well.jpg" alt="Being Well Brno" class="h-20 w-auto object-contain" loading="lazy" />
          <span class="text-zinc-400 text-xs tracking-[0.1em] uppercase group-hover:text-zinc-900 transition-colors">@beingwellbrno →</span>
        </a>

        <div class="flex flex-col items-center text-center gap-3">
          <div class="bg-zinc-900 px-6 py-4 inline-block">
            <img src="/images/kapka-resort-logo-white-transparent.png" alt="Kapka Resort" class="h-7 w-auto object-contain" loading="lazy" />
          </div>
          <p class="text-zinc-400 text-xs tracking-[0.1em] uppercase">Místo konání</p>
        </div>
      </div>
    </section>

    <!-- Signup form -->
    <section id="signup" class="px-6 sm:px-10 lg:px-20 py-24 border-t border-zinc-100">
      <div class="max-w-xl mx-auto reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6 text-center">Přihláška</p>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 mb-4 text-center">
          Chci na OFFLINE 1999.
        </h2>
        <p class="text-zinc-500 text-sm leading-relaxed mb-10 text-center">
          Přihlaš sebe i partu, se kterou jedeš. Stačí běžné jméno, ne to, co sis dal na dechovém semináři. Telefon a e-mail stačí vyplnit jednou za celou partu.
        </p>

        <div id="form-wrapper">
          <form
            id="retreat-form"
            name="retreat-90s"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-4"
          >
            <input type="hidden" name="form-name" value="retreat-90s" />
            <input type="hidden" name="bot-field" />
            <input type="hidden" name="pocet_ucastniku" id="pocet-ucastniku" value="1" />

            <div id="participants" class="space-y-6">
              {participantIndexes.map((i) => (
                <div class="participant-block space-y-3" data-index={i} hidden={i > 1}>
                  <p class="text-[10px] tracking-[0.3em] uppercase text-zinc-400">Účastník {i}</p>
                  <div class="grid sm:grid-cols-2 gap-4">
                    <input
                      type="text"
                      name={`participant_${i}_jmeno`}
                      placeholder="Jméno"
                      required={i === 1}
                      disabled={i > 1}
                      class="participant-field w-full px-4 py-3 border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 bg-white"
                    />
                    <input
                      type="text"
                      name={`participant_${i}_prijmeni`}
                      placeholder="Příjmení"
                      required={i === 1}
                      disabled={i > 1}
                      class="participant-field w-full px-4 py-3 border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 bg-white"
                    />
                  </div>
                  <input
                    type="number"
                    name={`participant_${i}_rok_narozeni`}
                    placeholder="Rok narození"
                    min="1920"
                    max="2026"
                    required={i === 1}
                    disabled={i > 1}
                    class="participant-field w-full sm:w-1/2 px-4 py-3 border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 bg-white"
                  />
                </div>
              ))}
            </div>

            <div class="flex items-center justify-between border-t border-b border-zinc-200 py-4">
              <p class="text-[10px] tracking-[0.2em] uppercase text-zinc-400">Počet účastníků</p>
              <div class="flex items-center gap-4">
                <button
                  type="button"
                  id="remove-participant"
                  aria-label="Odebrat účastníka"
                  disabled
                  class="w-9 h-9 flex items-center justify-center border border-zinc-300 text-zinc-500 hover:border-zinc-900 hover:text-zinc-900 disabled:opacity-30 disabled:hover:border-zinc-300 disabled:hover:text-zinc-500 transition-colors"
                >&minus;</button>
                <span id="participant-count" class="text-sm font-semibold text-zinc-900 w-4 text-center">1</span>
                <button
                  type="button"
                  id="add-participant"
                  aria-label="Přidat účastníka"
                  class="w-9 h-9 flex items-center justify-center border border-zinc-300 text-zinc-500 hover:border-zinc-900 hover:text-zinc-900 disabled:opacity-30 disabled:hover:border-zinc-300 disabled:hover:text-zinc-500 transition-colors"
                >+</button>
              </div>
            </div>

            <div>
              <label class="block text-[10px] tracking-[0.18em] uppercase text-zinc-400 mb-2">Telefon</label>
              <input
                type="tel"
                name="telefon"
                required
                placeholder="+420 xxx xxx xxx"
                class="w-full px-4 py-3 border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 bg-white"
              />
            </div>
            <div>
              <label class="block text-[10px] tracking-[0.18em] uppercase text-zinc-400 mb-2">E-mail</label>
              <input
                type="email"
                name="email"
                required
                placeholder="vas@email.cz"
                class="w-full px-4 py-3 border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 bg-white"
              />
            </div>
            <div>
              <label class="block text-[10px] tracking-[0.18em] uppercase text-zinc-400 mb-2">Poznámka (nepovinné)</label>
              <textarea
                name="poznamka"
                rows="3"
                placeholder="Alergie, stravovací omezení nebo cokoliv, co bychom měli vědět"
                class="w-full px-4 py-3 border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 resize-y bg-white"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center px-8 py-4 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200"
            >
              Odeslat přihlášku
            </button>
          </form>
        </div>
        <p class="text-zinc-400 text-xs text-center mt-6">adaptivestudio.cz · jiri@adaptivestudio.com · 736 445 942</p>
      </div>
    </section>

  </main>

  <Footer lang="cs" />
</Layout>

<script define:vars={{ maxParticipants: MAX_PARTICIPANTS }}>
  const earlybirdDeadline = new Date('2026-10-10T23:59:59+02:00');
  const daysLeft = Math.ceil((earlybirdDeadline - new Date()) / 86400000);
  const countdownEl = document.getElementById('earlybird-countdown');
  const urgencyEl = document.getElementById('earlybird-urgency');
  if (daysLeft > 0) {
    const label = daysLeft === 1 ? 'poslední den' : `posledních ${daysLeft} ${daysLeft < 5 ? 'dny' : 'dní'}`;
    if (countdownEl) countdownEl.textContent = label;
    if (urgencyEl) urgencyEl.textContent = `${label.charAt(0).toUpperCase()}${label.slice(1)} · do 10. října 2026`;
  } else {
    if (countdownEl) countdownEl.textContent = 'skončil';
    if (urgencyEl) urgencyEl.textContent = 'Skončil';
  }

  const form = document.getElementById('retreat-form');
  const wrapper = document.getElementById('form-wrapper');
  const countLabel = document.getElementById('participant-count');
  const countHidden = document.getElementById('pocet-ucastniku');
  const addBtn = document.getElementById('add-participant');
  const removeBtn = document.getElementById('remove-participant');

  let count = 1;

  function blockFor(i) {
    return document.querySelector(`.participant-block[data-index="${i}"]`);
  }

  function setBlockActive(i, active) {
    const block = blockFor(i);
    if (!block) return;
    block.hidden = !active;
    block.querySelectorAll('.participant-field').forEach((field) => {
      field.disabled = !active;
      field.required = active;
      if (!active) field.value = '';
    });
  }

  function render() {
    countLabel.textContent = String(count);
    countHidden.value = String(count);
    removeBtn.disabled = count <= 1;
    addBtn.disabled = count >= maxParticipants;
  }

  addBtn.addEventListener('click', () => {
    if (count >= maxParticipants) return;
    count += 1;
    setBlockActive(count, true);
    render();
  });

  removeBtn.addEventListener('click', () => {
    if (count <= 1) return;
    setBlockActive(count, false);
    count -= 1;
    render();
  });

  render();

  if (form && wrapper) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      try {
        const res = await fetch(window.location.pathname, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString(),
        });
        if (!res.ok) throw new Error(`Form submission failed: ${res.status}`);
        wrapper.innerHTML = `
          <p class="text-sm text-zinc-500 leading-relaxed text-center">Díky za přihlášku! Ozveme se s potvrzením a dalšími detaily.</p>
        `;
      } catch {
        form.submit();
      }
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('visible');
    } else {
      observer.observe(el);
    }
  });
</script>
