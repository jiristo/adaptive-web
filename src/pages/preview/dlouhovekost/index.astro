---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import StudioModal from '../../../components/StudioModal.astro';
---

<Layout
  title="Dlouhověkost — Adaptive Studio"
  description="Dlouhověkost není jen o délce života. Je to schopnost fungovat co nejdéle s energií, zdravím a soustředěním. Jak na to v Adaptive Studiu."
  lang="cs"
>
  <StudioModal lang="cs" />
  <Nav lang="cs" />

  <main>

    <!-- Hero -->
    <section class="min-h-screen flex flex-col justify-center px-6 sm:px-10 lg:px-20 py-24">
      <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-10">DLOUHOVĚKOST</p>
      <h1 class="font-heading font-bold leading-[0.9] tracking-tight text-zinc-900 mb-10 reveal"
          style="font-size: clamp(3rem, 9vw, 8rem)">
        Dlouhověkost není<br>o tom žít déle.
      </h1>
      <p class="text-lg sm:text-xl text-zinc-500 leading-relaxed max-w-xl reveal reveal-delay-1">
        Nežít jen déle. Fungovat déle dobře.
      </p>
    </section>

    <!-- Co to vlastně je — světlá -->
    <section class="min-h-screen flex flex-col px-6 sm:px-10 lg:px-20 py-24 border-t border-zinc-100">
      <div class="mb-16 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">CO TO VLASTNĚ JE</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
          Věda mluví jasně.
        </h2>
      </div>

      <div class="flex-1 grid md:grid-cols-3 md:divide-x divide-zinc-200 gap-16 md:gap-0">

        <div class="flex flex-col md:pr-12 reveal reveal-delay-1">
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">01</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Kvalita života, ne jen počet let</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">Nejde o počet let</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Dlouhověkost neznamená jen žít déle. Znamená co nejdéle dobře fungovat po tělesné i duševní stránce. Jde o roky prožité v dobré kondici, ne jen o samotný věk.
          </p>
        </div>

        <div class="flex flex-col md:px-12 reveal reveal-delay-2">
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">02</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Geny nejsou osud</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">80 % záleží na tobě</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Výzkumy ukazují, že genetika tvoří pouze 20–25 % toho, jak dlouho a jak dobře žijeme. Zbytek určuje životní styl — pohyb, stres, spánek, zánět. Věci, které lze vědomě ovlivnit.
          </p>
        </div>

        <div class="flex flex-col md:pl-12 reveal reveal-delay-3">
          <p class="font-heading font-bold text-zinc-100 leading-none mb-8 select-none"
             style="font-size: clamp(5rem, 10vw, 9rem)">03</p>
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Nervový systém jako základ</p>
          <p class="font-heading text-lg font-bold text-zinc-900 mb-3">Chronický stres stárne</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Dlouhodobý stres zvyšuje zátěž na celé tělo, zhoršuje obnovu sil a urychluje stárnutí. Schopnost vracet tělo zpět do klidu proto není módní trend, ale důležitý základ dlouhodobého zdraví.
          </p>
        </div>

      </div>
    </section>

    <!-- Proč to většina center dělá špatně — tmavá -->
    <section class="min-h-screen bg-[#111110] flex flex-col px-6 sm:px-10 lg:px-20 py-24">
      <div class="mb-16 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">PROBLÉM S TRHEM</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white">
          Proč většina center nestačí.
        </h2>
      </div>

      <div class="flex-1 grid md:grid-cols-2 gap-16 md:gap-0 md:divide-x divide-zinc-800">

        <div class="flex flex-col md:pr-12 reveal reveal-delay-1">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-6">Pasivní přístup</p>
          <p class="font-heading text-2xl font-bold text-white mb-4">Lehneš si. Odejdeš. Nic ses nenaučil.</p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Mnoho center nabízí procedury, které jsou příjemné a krátkodobě uleví. Masáže, kapačky, kryoterapie nebo červené světlo mohou pomoci. Pokud se ale člověk nenaučí lépe pracovat s vlastním tělem a stresem, vrací se brzy do stejného stavu jako předtím.
          </p>
        </div>

        <div class="flex flex-col md:pl-12 reveal reveal-delay-2">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-6">Optimalizace bez základu</p>
          <p class="font-heading text-2xl font-bold text-white mb-4">Doplňky stravy nestačí, když základ chybí.</p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Roste i nabídka rychlých řešení: doplňky, peptidy nebo různá chytrá zařízení. Některé z nich mohou mít své místo. Když ale chybí základy jako spánek, pohyb, práce se stresem a obnova sil, samy o sobě nestačí.
          </p>
        </div>

      </div>
    </section>

    <!-- Jak to děláme my — světlá -->
    <section class="min-h-screen flex flex-col px-6 sm:px-10 lg:px-20 py-24">
      <div class="mb-16 reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">NÁŠ PŘÍSTUP</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
          Čtyři pilíře. Jeden přístup.
        </h2>
        <p class="text-zinc-400 text-sm mt-4">Zaměřujeme se na oblasti, které mají největší vliv na to, jak dlouho a jak dobře člověk funguje.</p>
      </div>

      <div class="flex-1 grid md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-0 md:divide-x divide-zinc-200">

        <div class="flex flex-col lg:pr-8 reveal reveal-delay-1">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Pohyb</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Síla a kondice jsou základ</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Dobrá kondice patří mezi nejsilnější ukazatele dlouhodobého zdraví. Proto netrénujeme jen výkon, ale i kvalitu pohybu, stabilitu a schopnost těla zvládat zátěž bez zbytečného přepětí.
          </p>
        </div>

        <div class="flex flex-col lg:px-8 reveal reveal-delay-2">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Nervový systém</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Regulace jako dovednost</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Dlouhodobý stres tělo vyčerpává. Pomocí dechu, pohybu a jednoduchých postupů učíme tělo lépe přecházet mezi výkonem a odpočinkem, a to i mimo studio.
          </p>
        </div>

        <div class="flex flex-col lg:px-8 reveal reveal-delay-3">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Zánět</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Přímé nástroje obnovy</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Kryokomora a červené světlo používáme jako podpůrné nástroje pro rychlejší zklidnění, obnovu a lepší zvládání zátěže. Nejsou to atrakce navíc, ale součást promyšleného postupu.
          </p>
        </div>

        <div class="flex flex-col lg:pl-8 reveal reveal-delay-4">
          <p class="text-[10px] tracking-[0.35em] uppercase font-semibold text-sage mb-4">Mysl</p>
          <p class="font-heading text-xl font-bold text-zinc-900 mb-3">Vědomí jako nástroj</p>
          <p class="text-zinc-500 text-sm leading-relaxed">
            Meditace, protažení a práce s dechem nejsou jen odpočinek. Jsou to dovednosti, které pomáhají zklidnit mysl, lépe vnímat tělo a dlouhodobě posilovat odolnost vůči stresu.
          </p>
        </div>

      </div>
    </section>

    <!-- Co si odneseš — tmavá -->
    <section class="bg-[#111110] flex flex-col px-6 sm:px-10 lg:px-20 py-24">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="reveal">
          <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-6">CO NÁS ODLIŠUJE</p>
          <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight text-white mb-8">
            Odcházíš s dovedností.<br>Ne jen s pocitem.
          </h2>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6">
            V tom je náš přístup jiný. Nejde jen o příjemnou návštěvu nebo krátkou úlevu. Učíme tě postupy, které můžeš použít doma, v práci i ve chvílích, kdy je toho moc.
          </p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Práce s dechem, vědomý pohyb a schopnost zklidnit tělo mají přímý vliv na to, jak se cítíš dnes i jak budeš fungovat za roky.
          </p>
        </div>
        <div class="reveal reveal-delay-1 space-y-6">
          {[
            'Lépe zvládáš stres místo toho, aby jen vládl tobě',
            'Pohybuješ se s větší jistotou a menším přepětím',
            'Regeneruješ rychleji — po tréninku i po náročném dni',
            'Lépe rozumíš svému tělu a víš, jak na něj reagovat',
          ].map((item) => (
            <div class="flex items-start gap-4 border-b border-zinc-800 pb-6">
              <span class="text-sage text-lg mt-0.5">→</span>
              <p class="text-white font-medium text-sm">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="min-h-[60vh] flex flex-col items-center justify-center px-6 text-center py-24">
      <div class="reveal">
        <p class="text-[10px] tracking-[0.4em] uppercase text-sage mb-8">PRVNÍ KROK</p>
        <h2 class="font-heading font-bold leading-tight tracking-tight text-zinc-900 mb-8"
            style="font-size: clamp(2.5rem, 7vw, 5rem)">
          Začni žít déle — a lépe.
        </h2>
        <p class="text-zinc-500 text-sm leading-relaxed mb-3 max-w-sm mx-auto">
          Prvním krokem je 30minutový rozhovor. Podíváme se, kde právě jsi, co potřebuješ a jak může vypadat cesta, která pro tebe bude dávat smysl.
        </p>
        <p class="text-zinc-400 text-xs mb-12">Bez závazku.</p>
        <a
          href="https://calendly.com/jiri-adaptivestudio/30min"
          class="inline-flex items-center justify-center px-12 py-5 bg-zinc-900 text-white text-xs font-semibold tracking-[0.2em] uppercase hover:bg-zinc-700 transition-colors duration-200"
        >
          Zarezervovat konzultaci
        </a>
      </div>
    </section>

  </main>

  <Footer lang="cs" />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    },
    { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('visible');
    } else {
      observer.observe(el);
    }
  });
</script>
